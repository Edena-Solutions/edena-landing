---
import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card } from "@/components/ui/card";
import Icon from "@/components/ui/icon";
import GSAPSection from "@/components/ui/gsap-section";
import { PricingModules } from "@/components/PricingModules";
import { CENTER_PACKS, floorFor, formatPriceTrim } from "@/constants/pricing";
import type { PlanFeatureSection } from "@/constants/pricing";
import type { Translation } from "@/i18n";

interface Props {
    t: Translation;
    lang: string;
    demoUrl: string;
    registerUrl: string;
}

const { t, lang, demoUrl, registerUrl } = Astro.props;
const c = t.pricing.centers;
const sections = (t.pricing as { planFeatureSections?: PlanFeatureSection[] })
    .planFeatureSections ?? [];
// The "from" figure is the floor of the entry package (30 students x 1,20 EUR = 36), which is the
// lowest anyone can actually pay and matches the academies floor, so both audiences enter at the
// same number. `priceCaption` has to keep describing *this* package: point it at a richer one and
// the figure and its own caption end up describing different things.
const headlinePack = CENTER_PACKS[0];
const fromPrice = formatPriceTrim(floorFor(headlinePack.pricePerStudent, "centers"), lang);
---

<div class="flex flex-col gap-16 w-full">
    <div class="px-4 mx-auto w-full max-w-5xl">
        <Card
            className="grid gap-8 rounded bg-card p-8 md:grid-cols-2 md:items-center md:gap-12 md:p-10"
        >
            <div class="flex flex-col gap-3">
                <Badge variant="secondary" className="text-[10px] tracking-widest uppercase">
                    {t.pricing.hub.centers.badge}
                </Badge>
                <p class="flex items-baseline gap-2">
                    <span class="text-base font-normal text-muted-foreground"
                        >{t.pricing.fromLabel}</span
                    >
                    <span class="text-5xl font-bold">{fromPrice}</span>
                </p>
                <p class="text-[10px] tracking-widest uppercase text-muted-foreground">
                    {c.fromNote}
                </p>
                <p class="text-sm text-muted-foreground">{c.priceCaption}</p>
            </div>

            <div class="flex flex-col gap-6">
                <ul class="m-0 list-none space-y-2 p-0">
                    {
                        c.priceBullets.map((bullet) => (
                            <li class="flex items-start gap-2">
                                <Icon
                                    name="Check"
                                    size={14}
                                    className="mt-0.5 flex-shrink-0 text-muted-foreground"
                                />
                                <span class="text-sm leading-snug">{bullet}</span>
                            </li>
                        ))
                    }
                </ul>
                <div class="flex flex-col gap-2 sm:flex-row">
                    <a href={demoUrl} class="block w-full hover:no-underline">
                        <Button className="w-full">{t.bookDemo}</Button>
                    </a>
                    <a href={registerUrl} class="block w-full hover:no-underline">
                        <Button className="w-full" variant="secondary">{t.pricing.startNow}</Button>
                    </a>
                </div>
            </div>
        </Card>
    </div>

    <GSAPSection client:load className="flex flex-col gap-10 px-4">
        <div class="flex flex-col gap-4 text-center">
            <h2
                class="text-xl sm:text-3xl font-bold bg-gradient-to-r from-foreground to-foreground/40 bg-clip-text text-transparent max-w-lg sm:max-w-2xl text-center mx-auto"
            >
                {c.howTitle}
            </h2>
            <p class="text-muted-foreground max-w-2xl mx-auto">{c.howDescription}</p>
        </div>
        <ol class="m-0 grid list-none gap-4 p-0 mx-auto w-full max-w-5xl md:grid-cols-3">
            {
                c.steps.map((step, index) => (
                    <li>
                        <Card className="flex h-full flex-col gap-3 rounded bg-card p-6">
                            <span class="text-[10px] font-semibold tracking-widest uppercase text-muted-foreground">
                                {String(index + 1).padStart(2, "0")}
                            </span>
                            <h3 class="text-base font-bold">{step.title}</h3>
                            <p class="text-sm leading-snug text-muted-foreground">
                                {step.description}
                            </p>
                        </Card>
                    </li>
                ))
            }
        </ol>
    </GSAPSection>

    <GSAPSection client:load className="flex flex-col gap-10 px-4">
        <div class="flex flex-col gap-4 text-center">
            <h2
                class="text-xl sm:text-3xl font-bold bg-gradient-to-r from-foreground to-foreground/40 bg-clip-text text-transparent max-w-lg sm:max-w-2xl text-center mx-auto"
            >
                {c.modulesTitle}
            </h2>
            <p class="text-muted-foreground max-w-2xl mx-auto">{c.modulesDescription}</p>
        </div>
        <div class="mx-auto w-full max-w-5xl">
            <PricingModules sections={sections} />
        </div>
    </GSAPSection>
</div>
