---
import { Check } from "lucide-react";
import Button from "@/components/ds/Button.astro";
import SectionHeader from "@/components/ds/SectionHeader.astro";
import { ModuleIcon } from "@/modules/pricing/ModuleIcon";
import PricingNotes from "@/modules/pricing/PricingNotes.astro";
import {
    CENTER_PACKS,
    MODULE_IDS,
    floorFor,
    formatPriceTrim,
    moduleSectionsById,
} from "@/constants/pricing";
import type { PlanFeatureSection } from "@/constants/pricing";
import type { Translation } from "@/i18n";

/*
 * Centre pricing, in the home's design: the price it starts at, beside what that includes; how the
 * price is worked out, as the numbered tiles from the comparison's "switching" section; then
 * every module.
 *
 * Only a "from" figure is published (see `CENTER_PACKS`): this page speaks to nurseries, schools
 * and groups at once, and no single list serves all three.
 */
interface Props {
    t: Translation;
    lang: string;
    demoUrl: string;
    registerUrl: string;
}

const { t, lang, demoUrl, registerUrl } = Astro.props;
const c = t.pricing.centers;
const byId = moduleSectionsById(
    (t.pricing as { planFeatureSections?: PlanFeatureSection[] }).planFeatureSections ?? [],
);
// The "from" figure is the floor of the entry package (30 students x 1,20 EUR = 36), which is the
// lowest anyone can actually pay and matches the academies floor, so both audiences enter at the
// same number. `priceCaption` has to keep describing *this* package.
const fromPrice = formatPriceTrim(floorFor(CENTER_PACKS[0].pricePerStudent, "centers"), lang);
---

<!-- The price, and what it includes. -->
<section class="ds-section pt-12 sm:pt-16">
    <div class="ds-container flex flex-col gap-4">
        <div
            class="ds-tile grid gap-10 p-7 sm:p-12 lg:grid-cols-2 lg:items-center lg:gap-16"
            data-reveal="scale"
        >
            <div class="flex flex-col">
                <span class="flex flex-wrap gap-2" aria-hidden="true">
                    {
                        MODULE_IDS.slice(0, 3).map((moduleId) => (
                            <ModuleIcon moduleId={moduleId} className="size-10 rounded-[0.5rem]" />
                        ))
                    }
                </span>
                <p class="mt-8 flex items-baseline gap-2">
                    <span class="type-callout text-ink-2">{t.pricing.fromLabel}</span>
                    <span
                        class="text-[3.75rem] font-semibold leading-none tracking-[-0.045em] tabular-nums text-ink sm:text-[4.75rem]"
                    >
                        {fromPrice}
                    </span>
                </p>
                <p class="mt-3 type-footnote text-ink-3">{c.fromNote}</p>
                <p class="mt-5 max-w-sm type-callout text-ink-2">{c.priceCaption}</p>
            </div>
            <div class="flex flex-col gap-8">
                <ul class="m-0 flex list-none flex-col gap-4 p-0">
                    {
                        c.priceBullets.map((bullet) => (
                            <li class="flex items-start gap-3">
                                <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand-ink">
                                    <Check className="size-3" strokeWidth={3} />
                                </span>
                                <span class="type-body text-ink">{bullet}</span>
                            </li>
                        ))
                    }
                </ul>
                <div class="flex flex-col gap-3 sm:flex-row">
                    <Button href={demoUrl} size="lg" class="sm:flex-1">{t.bookDemo}</Button>
                    <Button href={registerUrl} variant="secondary" size="lg" class="sm:flex-1"
                        >{t.pricing.startNow}</Button
                    >
                </div>
            </div>
        </div>
        <PricingNotes t={t} />
    </div>
</section>

<!-- How the price is worked out. -->
<section class="ds-section">
    <div class="ds-container">
        <SectionHeader title={c.howTitle} description={c.howDescription} />

        <div class="mt-10 grid grid-cols-2 gap-3 sm:mt-14 sm:gap-4 lg:grid-cols-3" data-reveal-group>
            <div class="how-list col-span-2 sm:contents">
                {
                    c.steps.map((step, index) => (
                        <article
                            class:list={[
                                "ds-tile how-row",
                                index === c.steps.length - 1 && "sm:col-span-2 lg:col-span-1",
                            ]}
                            data-reveal="scale"
                        >
                            <p class="how-row-value font-semibold leading-none tracking-[-0.045em] text-ink">
                                {index + 1}
                            </p>
                            <div class="how-row-copy">
                                <h3 class="how-row-title">{step.title}</h3>
                                <p class="how-row-desc text-ink-2">{step.description}</p>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>

        <!-- The price for this centre, closed in the demo. -->
        <div
            class="mt-4 flex flex-col items-center gap-5 rounded-tile bg-ink px-7 py-12 text-center text-canvas sm:py-16"
            data-reveal="scale"
        >
            <h3 class="type-title-1 max-w-xl">{c.ctaTitle}</h3>
            <p class="type-callout max-w-xl opacity-70">{c.ctaDescription}</p>
            <a href={demoUrl} class="ds-btn ds-btn--lg mt-2 bg-canvas text-ink hover:opacity-90"
                >{t.bookDemo}</a
            >
        </div>
    </div>
</section>

<!-- Every module. -->
<section class="ds-section pt-0">
    <div class="ds-container">
        <SectionHeader title={c.modulesTitle} description={c.modulesDescription} />
        <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" data-reveal-group>
            {
                MODULE_IDS.map((moduleId) => {
                    const section = byId[moduleId];
                    if (!section) return null;
                    // The base platform is where every centre starts: it spans the row, the nine
                    // modules that sit on it fill three by three.
                    const base = moduleId === "platformBase";
                    return (
                        <article
                            class:list={[
                                "ds-tile flex flex-col gap-5 p-7",
                                base && "sm:col-span-2 lg:col-span-3 sm:p-9",
                            ]}
                            data-reveal="scale"
                        >
                            <span class="flex items-center gap-3">
                                <ModuleIcon
                                    moduleId={moduleId}
                                    className={
                                        base
                                            ? "size-12 rounded-[0.5rem]"
                                            : "size-11 rounded-[0.5rem]"
                                    }
                                />
                                <h3
                                    class:list={[
                                        base ? "type-title-2" : "type-title-3",
                                        "text-ink",
                                    ]}
                                >
                                    {section.title}
                                </h3>
                            </span>
                            <ul
                                class:list={[
                                    "m-0 grid list-none gap-2.5 p-0",
                                    base && "sm:grid-cols-2 sm:gap-x-10",
                                ]}
                            >
                                {section.items.map((item) => (
                                    <li class="flex items-start gap-2.5">
                                        <Check
                                            className="mt-1 size-3.5 shrink-0 text-brand-ink"
                                            strokeWidth={2.6}
                                        />
                                        <span class="type-footnote text-ink-2">{item.label}</span>
                                    </li>
                                ))}
                            </ul>
                        </article>
                    );
                })
            }
        </div>
    </div>
</section>

<style>
    /* The variables. A phone: rows of one grouped panel, hairlines between them. */
    @media (max-width: 39.99rem) {
        .how-list {
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border-radius: var(--radius-tile);
            background-color: var(--ds-canvas-2);
        }

        .how-row {
            display: grid;
            grid-template-columns: 3.25rem minmax(0, 1fr);
            align-items: center;
            column-gap: 1rem;
            padding: 1.15rem 1.5rem;
            border-radius: 0;
            background: none;
        }

        .how-row + .how-row::before {
            content: "";
            position: absolute;
            top: 0;
            right: 1.5rem;
            left: 1.5rem;
            height: 1px;
            background: var(--ds-hairline);
        }

        .how-row-value {
            font-size: 1.875rem;
        }

        .how-row-desc {
            font-size: 0.875rem;
            line-height: 1.4;
            text-wrap: pretty;
        }
    }

    /* From a tablet up: each its own tile, the figure at its head and the line at its foot. */
    @media (min-width: 40rem) {
        .how-row {
            display: flex;
            min-height: 13rem;
            flex-direction: column;
            justify-content: space-between;
            gap: 1.5rem;
            padding: 1.75rem;
        }

        .how-row-value {
            font-size: 3.25rem;
        }

        .how-row-desc {
            font-size: 0.9375rem;
            line-height: 1.45;
        }
    }

    .how-row-value,
    .how-row-title,
    .how-row-desc {
        margin: 0;
    }

    .how-row-title {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.3;
        letter-spacing: -0.02em;
        color: var(--ds-ink);
    }

    .how-row-desc {
        margin-top: 0.2rem;
        color: var(--ds-ink-2);
        text-wrap: pretty;
    }

    /* On a tablet the third step fills the row, so its number sits beside the line. */
    @media (min-width: 40rem) and (max-width: 63.99rem) {
        .how-row:last-child {
            flex-direction: row;
            align-items: center;
            justify-content: flex-start;
            gap: 1.75rem;
        }
    }
</style>
