---
import { Check, Landmark, School } from "lucide-react";
import Button from "@/components/ds/Button.astro";
import { ModuleIcon } from "@/modules/pricing/ModuleIcon";
import { CENTER_PACKS, MODULE_IDS, PACKS, floorFor, formatPrice, formatPriceTrim } from "@/constants/pricing";
import type { Translation } from "@/i18n";

/*
 * The pricing hub's choice: academies or education centres, side by side, each with the price it
 * starts at and what that buys. Above each, a drawing of what the page behind it offers — the three
 * academy packs fanned out, the ten centre modules laid out as app icons.
 */
interface Props {
    t: Translation;
    lang: string;
    academiesUrl: string;
    centersUrl: string;
}

const { t, lang, academiesUrl, centersUrl } = Astro.props;
const hub = t.pricing.hub;
const cheapestPack = Math.min(...PACKS.map((pack) => pack.pricePerStudent));
// Entry package, so this card quotes the same figure as the centres page it links to.
const centersHeadline = CENTER_PACKS[0];

const cards = [
    {
        ...hub.academies,
        key: "academies",
        icon: Landmark,
        tone: "bg-sys-orange",
        price: formatPrice(cheapestPack, lang),
        priceNote: t.pricing.perStudent,
        href: academiesUrl,
    },
    {
        ...hub.centers,
        key: "centers",
        icon: School,
        tone: "bg-sys-blue",
        price: formatPriceTrim(floorFor(centersHeadline.pricePerStudent, "centers"), lang),
        href: centersUrl,
    },
];
---

<div class="grid gap-4 lg:grid-cols-2" data-reveal-group>
    {
        cards.map((card) => {
            const Icon = card.icon;
            return (
                <article class="ds-tile flex flex-col p-7 sm:p-10" data-reveal="scale">
                    {/* What the page behind it offers, drawn. */}
                    <div class="pricing-art relative mb-8 h-36 sm:h-40" aria-hidden="true">
                        {card.key === "academies" ? (
                            <div class="absolute inset-0 flex items-center justify-center">
                                {PACKS.map((pack, index) => (
                                    <div
                                        class="pricing-pack absolute flex w-[11rem] flex-col gap-2 rounded-[1.1rem] p-4 ds-glass"
                                        style={`--i: ${index - 1}; --glass-radius: 1.1rem`}
                                    >
                                        <span class="truncate text-[0.7rem] font-semibold text-ink sm:text-[0.8rem]">{t.pricing.packs.items[pack.id].name}</span>
                                        <span class="text-[1.4rem] font-semibold leading-none tracking-[-0.03em] tabular-nums text-ink">
                                            {formatPrice(pack.pricePerStudent, lang)}
                                        </span>
                                        <span class="flex gap-1">
                                            {pack.modules.slice(0, 5).map((moduleId) => (
                                                <ModuleIcon moduleId={moduleId} className="size-5 !shadow-none" />
                                            ))}
                                        </span>
                                    </div>
                                ))}
                            </div>
                        ) : (
                            <div class="absolute inset-0 flex items-center justify-center">
                                <div class="grid grid-cols-5 gap-3">
                                    {MODULE_IDS.map((moduleId, index) => (
                                        <span class="pricing-module" style={`--i: ${index}`}>
                                            <ModuleIcon moduleId={moduleId} className="size-12 sm:size-14" />
                                        </span>
                                    ))}
                                </div>
                            </div>
                        )}
                    </div>

                    <div class="flex items-center gap-3">
                        <span class:list={["ds-app-icon size-9", card.tone]}>
                            <Icon className="size-[1.1rem]" />
                        </span>
                        <span class="type-callout font-semibold text-ink-2">{card.badge}</span>
                    </div>
                    <h2 class="mt-5 type-title-1 text-ink">{card.title}</h2>
                    <p class="mt-3 max-w-md type-callout text-ink-2">{card.description}</p>

                    <p class="mt-8 flex items-baseline gap-2">
                        <span class="type-callout text-ink-2">{t.pricing.fromLabel}</span>
                        <span class="text-[3.25rem] font-semibold leading-none tracking-[-0.045em] tabular-nums text-ink sm:text-[3.75rem]">
                            {card.price}
                        </span>
                    </p>
                    <p class="mt-2 type-footnote text-ink-3">{card.priceNote}</p>

                    <ul class="m-0 mt-8 flex list-none flex-col gap-3 border-t border-hairline p-0 pt-7">
                        {card.features.map((feature) => (
                            <li class="flex items-start gap-3">
                                <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand-ink">
                                    <Check className="size-3" strokeWidth={3} />
                                </span>
                                <span class="type-callout text-ink">{feature}</span>
                            </li>
                        ))}
                    </ul>

                    <div class="mt-auto pt-9">
                        <Button href={card.href} size="lg" class="w-full">
                            {card.cta}
                        </Button>
                    </div>
                </article>
            );
        })
    }
</div>

<style>
    /* The three packs, fanned like cards in a hand: the popular one in front. */
    .pricing-pack {
        transform: translateX(calc(var(--i) * 9.25rem)) rotate(calc(var(--i) * 4deg)) translateY(calc(var(--i) * var(--i) * 0.5rem));
    }

    @media (max-width: 639px) {
        .pricing-pack {
            width: 8.5rem;
            transform: translateX(calc(var(--i) * 6rem)) rotate(calc(var(--i) * 4deg)) translateY(calc(var(--i) * var(--i) * 0.4rem));
        }
    }

    /* As the tile comes into view, the packs spread out and the modules light one by one. */
    @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
        [data-reveal] .pricing-pack {
            transition: transform 1.1s var(--ease-out-expo) 0.25s;
        }

        [data-reveal]:not([data-revealed]) .pricing-pack {
            transform: none;
        }

        [data-reveal] .pricing-module {
            display: inline-flex;
            transition:
                opacity 0.6s var(--ease-out-expo),
                transform 0.8s var(--ease-spring);
            transition-delay: calc(0.2s + var(--i) * 55ms);
        }

        [data-reveal]:not([data-revealed]) .pricing-module {
            opacity: 0;
            transform: scale(0.6);
        }
    }
</style>
