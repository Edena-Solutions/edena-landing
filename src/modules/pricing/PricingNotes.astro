---
import { ArrowRightLeft, LockOpen, TrendingDown } from "lucide-react";
import type { Translation } from "@/i18n";

/*
 * What every plan comes with, academy or centre: no lock-in, onboarding included, volume
 * discounts. Three quiet tiles under the prices, so the price is never read without them.
 */
interface Props {
    t: Translation;
}

const { t } = Astro.props;
const icons = [LockOpen, ArrowRightLeft, TrendingDown];
---

<ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-3" data-reveal-group>
    {
        t.pricing.packs.notes.map((note, index) => {
            const Icon = icons[index];
            return (
                <li class="flex items-start gap-4 rounded-[1.4rem] bg-canvas-2 p-6" data-reveal>
                    <span class="ds-app-icon size-10 bg-brand-soft text-brand-ink">
                        <Icon className="size-5" />
                    </span>
                    <span class="flex flex-col gap-1">
                        <span class="type-callout font-semibold text-ink">{note.title}</span>
                        <span class="type-footnote text-ink-2">{note.description}</span>
                    </span>
                </li>
            );
        })
    }
</ul>
