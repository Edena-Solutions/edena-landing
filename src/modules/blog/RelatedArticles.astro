---
import { ChevronRight } from "lucide-react";
import type { Translation } from "@/i18n";
import { coverAt, readingMinutes } from "@/lib/blog-article";

/*
 * The posts a post points to, set where its text names them (before the conclusion): one quiet
 * panel, a row per post with its cover, title and reading time.
 */
interface Props {
    t: Translation;
    posts: { href: string; title: string; cover?: string; body: string }[];
}

const { t, posts } = Astro.props;
---

<aside class="my-12 rounded-[1.5rem] bg-canvas-2 p-2 sm:p-3" aria-labelledby="related-articles">
    <h2 id="related-articles" class="px-3 pb-2 pt-3 type-callout font-semibold text-ink-2">{t.blog.relatedTitle}</h2>
    <ul class="m-0 flex list-none flex-col p-0">
        {
            posts.map((post) => (
                <li>
                    <a href={post.href} class="related-row group">
                        <span class="related-thumb">
                            {post.cover && <img src={coverAt(post.cover, 240)} alt="" loading="lazy" decoding="async" />}
                        </span>
                        <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                            <span class="line-clamp-2 type-callout font-semibold text-ink">{post.title}</span>
                            <span class="type-footnote text-ink-3">
                                {t.blogPage.readingTime.replace("{n}", String(readingMinutes(post.body)))}
                            </span>
                        </span>
                        <ChevronRight className="related-chevron" />
                    </a>
                </li>
            ))
        }
    </ul>
</aside>

<style>
    .related-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        border-radius: 1.1rem;
        padding: 0.6rem 1rem 0.6rem 0.6rem;
        transition: background-color 200ms var(--ease-fluid);
    }

    .related-row:hover {
        background-color: var(--ds-fill-2);
    }

    .related-row:focus-visible {
        outline: 2px solid var(--ds-focus);
        outline-offset: 2px;
    }

    .related-thumb {
        position: relative;
        width: 4.5rem;
        height: 4.5rem;
        flex-shrink: 0;
        overflow: hidden;
        border-radius: 0.9rem;
        background-color: var(--ds-fill-2);
    }

    .related-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: scale 700ms var(--ease-spring);
    }

    .related-row:hover .related-thumb img {
        scale: 1.06;
    }

    .related-row :global(.related-chevron) {
        width: 1rem;
        height: 1rem;
        flex-shrink: 0;
        color: var(--ds-ink-3);
        transition: translate 500ms var(--ease-spring);
    }

    .related-row:hover :global(.related-chevron) {
        translate: 0.2rem 0;
    }
</style>
