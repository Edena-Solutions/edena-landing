---
/*
 * A page's opening without a product to show — pricing, contact, the demo: an eyebrow, the
 * statement and the line that explains it, rising on load like every hero on the site, with room
 * underneath (`slot`) for whatever the page asks first.
 */
interface Props {
    title: string;
    description: string;
    /**
     * What the page is ("Precios para academias"), set small above the statement. Inside the H1, as
     * on product pages, so the heading carries the words the page is searched by.
     */
    eyebrow?: string;
    /** Where the eyebrow leads, when it is the way back to a parent page. */
    eyebrowHref?: string;
}

const { title, description, eyebrow, eyebrowHref } = Astro.props;
---

<section class="relative isolate -mt-15 overflow-x-clip pt-15">
    <div class="ds-container flex flex-col items-center pt-14 text-center">
        {
            eyebrow && eyebrowHref && (
                <a
                    href={eyebrowHref}
                    class="ds-intro ds-link mb-4 type-callout font-semibold"
                    style="--intro-i: 0"
                >
                    {eyebrow}
                </a>
            )
        }
        <h1 class="ds-intro max-w-4xl" style="--intro-i: 0">
            {
                eyebrow && !eyebrowHref && (
                    <span class="mb-4 block type-callout font-semibold text-brand-ink">{eyebrow}</span>
                )
            }
            <span class="block type-display-1 pb-2 text-gradient-ink">{title}</span>
        </h1>
        <p class="ds-intro type-lead mt-6 max-w-2xl text-ink-2" style="--intro-i: 1">
            {description}
        </p>
        <slot />
    </div>
</section>
