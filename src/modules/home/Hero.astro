---
import { BadgeCheck, Baby, ChevronRight, Landmark, School } from "lucide-react";
import type { Translation } from "@/i18n";
import { getLanguageFromURL, localizedDemoPath, useTranslatedPath } from "@/i18n";
import Button from "@/components/ds/Button.astro";
import HeroScene from "@/components/illustrations/HeroScene.astro";
import AppNotifications from "@/components/illustrations/AppNotifications.astro";
import IntegrationsFlow from "@/components/illustrations/IntegrationsFlow.astro";

/*
 * The opening: the promise, the two ways in, and Edena drawn rather than screenshotted — a
 * student's record coming to life on a pane of glass, the platform standing in depth behind it —
 * on a tile, as every product page opens: a margin above, the front pane running past the tile's
 * foot. Under it, two tiles more, as one block. The headline rises on load (it is above the fold,
 * no observer would see it arrive).
 */
interface Props {
    t: Translation;
}

const { t } = Astro.props;
const { integrationsSection } = t;
const lang = getLanguageFromURL(Astro.url.pathname);
const translatePath = useTranslatedPath(lang);
---

<section class="relative isolate -mt-15 overflow-x-clip py-15">
    <div class="ds-container flex flex-col items-center pt-14 text-center">
        <!-- What Edena is and who it is for comes first, inside the H1, for a visitor with no context. -->
        <h1 class="ds-intro max-w-3xl" style="--intro-i: 0">
            <span class="mb-4 block type-callout font-semibold text-brand-ink"
                >{t.hero.eyebrow}</span
            >
            <span class="block type-display-3 pb-2 text-gradient-ink">
                {t.hero.mainTitle.split("\n").map((line) => <span class="block">{line}</span>)}
            </span>
        </h1>
        <p class="ds-intro type-body mt-5 max-w-2xl text-ink-2" style="--intro-i: 2">
            {t.hero.mainDescription}
        </p>
        <div
            class="ds-intro mt-9 flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:items-center"
            style="--intro-i: 3"
        >
            <Button href={localizedDemoPath(lang)} size="lg">
                {t.bookDemo}
            </Button>
            <Button href="https://app.edena.es/register-organization" variant="secondary" size="lg">
                {t.registerButtonExtended}
            </Button>
        </div>
        <p class="ds-intro mt-4 type-footnote text-ink-3" style="--intro-i: 4">
            {t.hero.demoNote}
        </p>
        <p class="ds-intro type-footnote text-ink-3" style="--intro-i: 4">
            {t.noCreditCardRequired}
        </p>
        <p
            class="ds-intro mt-4 inline-flex items-center gap-1.5 type-footnote font-medium text-ink-2"
            style="--intro-i: 4"
        >
            <BadgeCheck className="size-4 shrink-0 text-brand-ink" aria-hidden="true" />
            {t.hero.verifactuReady}
        </p>
        <nav
            class="ds-intro mt-8 flex flex-wrap items-center justify-center gap-2"
            aria-label={t.hero.pathsLabel}
            style="--intro-i: 5"
        >
            <a
                class="hero-path type-callout"
                style="--path: var(--ds-sys-blue)"
                href={translatePath("/schools")}
            >
                <School aria-hidden="true" />
                {t.navigation.schools}
            </a>
            <a
                class="hero-path type-callout"
                style="--path: var(--ds-sys-pink)"
                href={translatePath("/nurseries")}
            >
                <Baby aria-hidden="true" />
                {t.navigation.nurseries}
            </a>
            <a
                class="hero-path type-callout"
                style="--path: var(--ds-sys-orange)"
                href={translatePath("/academies")}
            >
                <Landmark aria-hidden="true" />
                {t.navigation.academies}
            </a>
        </nav>
    </div>

    <!-- On a phone the illustration takes its own, narrower composition, and shows whole. -->
    <div class="ds-container mt-12 sm:mt-16">
        <div class="ds-tile hero-stage">
            <div class="hero-stage__art">
                <HeroScene t={t} lang={lang} />
            </div>
        </div>
    </div>

    <div class="ds-container mt-4 grid gap-4 lg:grid-cols-2" data-reveal-group>
        <article class="ds-tile flex flex-col pt-10 sm:pt-12" data-reveal="scale">
            <div class="flex flex-col items-center gap-3 px-6 text-center sm:px-10">
                <h2 class="type-title-1 max-w-md text-ink">{t.hero.mobileTitle}</h2>
                <p class="type-callout max-w-md text-ink-2">{t.hero.mobileDescription}</p>
                <a href={translatePath("/app")} class="ds-link type-callout mt-1">
                    {t.features.mobileApp.cta}<ChevronRight aria-hidden="true" />
                </a>
            </div>
            <div class="mt-auto">
                <AppNotifications t={t} />
            </div>
        </article>

        <article class="ds-tile flex flex-col pt-10 sm:pt-12" data-reveal="scale">
            <div class="flex flex-col items-center gap-3 px-6 text-center sm:px-10">
                <h2 class="type-title-1 max-w-md text-ink">{integrationsSection.title}</h2>
                <p class="type-callout max-w-md text-ink-2">{integrationsSection.description}</p>
            </div>
            <div class="mt-auto">
                <IntegrationsFlow t={t} />
            </div>
        </article>
    </div>
</section>

<style>
    /* A tinted pill for each kind of centre. The colour is the fill, at a little opacity. */
    .hero-path {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        min-height: 2.25rem;
        padding: 0.3rem 0.9rem 0.3rem 0.7rem;
        border-radius: 999px;
        background: color-mix(in srgb, var(--path) 14%, transparent);
        color: var(--path);
        font-weight: 500;
        transition: background-color 240ms var(--ease-fluid);
    }

    .hero-path svg {
        width: 1rem;
        height: 1rem;
        flex-shrink: 0;
    }

    .hero-path:hover {
        background: color-mix(in srgb, var(--path) 24%, transparent);
    }

    .hero-path:focus-visible {
        outline: 2px solid var(--ds-focus);
        outline-offset: 3px;
    }

    /* The board as wide as the tile allows less its margins, from a margin at the top down past the
       tile's foot, which cuts the front pane: wide, about where its cards end (34 of the board's
       38 em); on a phone (under 45rem of tile, so the board stays under 40rem), the record's tall
       pane just under its note (24.6 of 26.3 em), at most 26rem wide. The tile clips; the lights
       behind the glass tint it. */
    .hero-stage {
        container-type: inline-size;
    }

    .hero-stage__art {
        --top: 1.75rem;
        --b: min(100cqw - 1.5rem, 26rem);
        padding: var(--top) calc((100cqw - var(--b)) / 2) 0;
        height: calc(var(--top) + var(--b) * 24.6 / 18.4);
    }

    @container (min-width: 45rem) {
        .hero-stage__art {
            --top: 3rem;
            --b: calc(100cqw - 5rem);
            height: calc(var(--top) + var(--b) * 34 / 75);
        }
    }
</style>
