---
import SectionHeader from "@/components/ds/SectionHeader.astro";
import type { Translation } from "@/i18n";

/*
 * Results, set the way Apple sets a number: large, tight, and counted up once on arrival (the real
 * figure is what the markup carries; the count is only motion). The headline figure gets activity
 * rings in Edena's greens.
 */
interface Props {
    t: Translation;
}

const { t } = Astro.props;
const { erpStats } = t;
const [lead, ...rest] = erpStats.cases.slice(0, 5);

/** Three rings, outermost first: radius on a 120 box, and how far each closes. */
const rings = [
    { r: 52, to: 8, color: "#a3e635" },
    { r: 39, to: 22, color: "#22c55e" },
    { r: 26, to: 36, color: "#14b8a6" },
];
---

<section class="ds-section">
    <div class="ds-container">
        <SectionHeader title={erpStats.title} description={erpStats.description} />

        <div class="mt-14 grid grid-cols-2 gap-4 lg:grid-cols-4" data-reveal-group>
            <article
                class="ds-tile col-span-2 flex min-h-[22rem] flex-col justify-between gap-10 p-8 sm:p-10 lg:row-span-2"
                data-reveal="scale"
            >
                <svg viewBox="0 0 120 120" class="size-36 -rotate-90 sm:size-44" aria-hidden="true">
                    {
                        rings.map((ring, index) => (
                            <g>
                                <circle cx="60" cy="60" r={ring.r} fill="none" stroke={ring.color} stroke-opacity="0.18" stroke-width="10" />
                                <circle
                                    class="stat-ring"
                                    cx="60"
                                    cy="60"
                                    r={ring.r}
                                    fill="none"
                                    stroke={ring.color}
                                    stroke-width="10"
                                    stroke-linecap="round"
                                    pathLength="100"
                                    style={`--to:${ring.to};--i:${index}`}
                                />
                            </g>
                        ))
                    }
                </svg>
                <div>
                    <p class="type-stat text-gradient-brand" data-count>{lead.stat}</p>
                    <p class="mt-4 max-w-sm type-body text-ink-2">{lead.description}</p>
                </div>
            </article>

            {
                rest.map((item) => (
                    <article class="ds-tile flex min-h-[13rem] flex-col justify-between gap-6 p-6 sm:p-7" data-reveal="scale">
                        <p
                            class="text-[2.6rem] font-semibold leading-none tracking-[-0.045em] text-ink sm:text-[3.25rem]"
                            data-count
                        >
                            {item.stat}
                        </p>
                        <p class="type-callout text-ink-2">{item.description}</p>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .stat-ring {
        stroke-dasharray: 100;
        stroke-dashoffset: var(--to);
        transition: stroke-dashoffset 1.8s var(--ease-out-expo);
        transition-delay: calc(var(--i) * 150ms + 250ms);
    }

    @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
        :global([data-reveal]:not([data-revealed])) .stat-ring {
            stroke-dashoffset: 100;
        }
    }
</style>
