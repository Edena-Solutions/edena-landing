---
import SectionHeader from "@/components/ds/SectionHeader.astro";
import gimbebeLogo from "@/assets/img/logos/gimbebe.png";
import type { Translation } from "@/i18n";

/*
 * Results, set the way Apple sets a number: large, tight, and counted up once on arrival (the real
 * figure is what the markup carries; the count is only motion). The headline figure gets activity
 * rings in Edena's greens.
 *
 * Wide, the headline is a tall tile beside four smaller ones. Below that the headline lies on its
 * side — the figure and its line on the left, the rings on the right — so it holds no empty field;
 * and on a phone the other four stack as rows of one grouped panel, the figure beside its line,
 * as iOS lists them, rather than four narrow tiles whose text wraps word by word.
 */
interface Props {
    t: Translation;
}

const { t } = Astro.props;
const { erpStats } = t;
const [lead, ...rest] = erpStats.cases.slice(0, 5);

/** Three rings, outermost first: radius on a 120 box, and how far each closes. */
const rings = [
    { r: 52, to: 8, color: "#a3e635" },
    { r: 39, to: 22, color: "#22c55e" },
    { r: 26, to: 36, color: "#14b8a6" },
];
---

<section class="ds-section mt-20">
    <div class="ds-container">
        <SectionHeader title={erpStats.title} description={erpStats.description} />

        <div
            class="mt-10 grid grid-cols-2 gap-3 sm:mt-14 sm:gap-4 lg:grid-cols-4"
            data-reveal-group
        >
            <article class="ds-tile stat-lead col-span-2 lg:row-span-2" data-reveal="scale">
                <svg viewBox="0 0 120 120" class="stat-lead-rings -rotate-90" aria-hidden="true">
                    {
                        rings.map((ring, index) => (
                            <g>
                                <circle
                                    cx="60"
                                    cy="60"
                                    r={ring.r}
                                    fill="none"
                                    stroke={ring.color}
                                    stroke-opacity="0.18"
                                    stroke-width="10"
                                />
                                <circle
                                    class="stat-ring"
                                    cx="60"
                                    cy="60"
                                    r={ring.r}
                                    fill="none"
                                    stroke={ring.color}
                                    stroke-width="10"
                                    stroke-linecap="round"
                                    pathLength="100"
                                    style={`--to:${ring.to};--i:${index}`}
                                />
                            </g>
                        ))
                    }
                </svg>
                <p class="stat-lead-value type-stat text-gradient-brand" data-count>{lead.stat}</p>
                <div class="stat-lead-desc">
                    <img
                        src={gimbebeLogo.src}
                        alt="Gimbebe"
                        width={gimbebeLogo.width}
                        height={gimbebeLogo.height}
                        class="mb-3 h-7 w-auto"
                    />
                    <p class="type-body text-ink-2">{lead.description}</p>
                </div>
            </article>

            <div class="stat-list col-span-2 sm:contents">
                {
                    rest.map((item) => (
                        <article class="ds-tile stat-row" data-reveal="scale">
                            <p
                                class="stat-row-value font-semibold leading-none tracking-[-0.045em] text-ink"
                                data-count
                            >
                                {item.stat}
                            </p>
                            <p class="stat-row-desc text-ink-2">{item.description}</p>
                        </article>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    /* The headline. A phone: the figure and the rings side by side, the line under both. */
    .stat-lead {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas:
            "value rings"
            "desc desc";
        align-items: center;
        column-gap: 1rem;
        row-gap: 1rem;
        padding: 1.75rem;
    }

    .stat-lead-rings {
        grid-area: rings;
        width: 5.75rem;
        height: 5.75rem;
    }

    .stat-lead-value {
        grid-area: value;
    }

    .stat-lead-desc {
        grid-area: desc;
        max-width: 28rem;
    }

    /* A tablet: the figure and its line on the left, the rings large on the right. */
    @media (min-width: 40rem) {
        .stat-lead {
            grid-template-areas:
                "value rings"
                "desc rings";
            align-content: center;
            column-gap: 2.5rem;
            row-gap: 1rem;
            padding: 2.5rem;
        }

        .stat-lead-value {
            align-self: end;
        }

        .stat-lead-desc {
            align-self: start;
        }

        .stat-lead-rings {
            width: 10rem;
            height: 10rem;
        }
    }

    /* Wide: the tall tile, the rings at its head and the figure at its foot. */
    @media (min-width: 64rem) {
        .stat-lead {
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: auto 1fr auto auto;
            grid-template-areas:
                "rings"
                "."
                "value"
                "desc";
            align-items: start;
            row-gap: 1rem;
            min-height: 22rem;
        }

        .stat-lead-rings {
            width: 11rem;
            height: 11rem;
        }
    }

    /* The other four. A phone: rows of one grouped panel, hairlines between them. */
    @media (max-width: 39.99rem) {
        .stat-list {
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border-radius: var(--radius-tile);
            background-color: var(--ds-canvas-2);
        }

        .stat-row {
            display: grid;
            grid-template-columns: 5.5rem minmax(0, 1fr);
            align-items: center;
            column-gap: 1rem;
            padding: 1.15rem 1.5rem;
            border-radius: 0;
            background: none;
        }

        .stat-row + .stat-row::before {
            content: "";
            position: absolute;
            top: 0;
            left: 1.5rem;
            right: 1.5rem;
            height: 1px;
            background: var(--ds-hairline);
        }

        .stat-row-value {
            font-size: 1.875rem;
        }

        .stat-row-desc {
            font-size: 0.875rem;
            line-height: 1.4;
            text-wrap: pretty;
        }
    }

    /* From a tablet up: each its own tile, the figure at its head and the line at its foot. */
    @media (min-width: 40rem) {
        .stat-row {
            display: flex;
            min-height: 13rem;
            flex-direction: column;
            justify-content: space-between;
            gap: 1.5rem;
            padding: 1.75rem;
        }

        .stat-row-value {
            font-size: 3.25rem;
        }

        .stat-row-desc {
            font-size: 0.9375rem;
            line-height: 1.45;
        }
    }

    .stat-ring {
        stroke-dasharray: 100;
        stroke-dashoffset: var(--to);
        transition: stroke-dashoffset 1.8s var(--ease-out-expo);
        transition-delay: calc(var(--i) * 150ms + 250ms);
    }

    @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
        :global([data-reveal]:not([data-revealed])) .stat-ring {
            stroke-dashoffset: 100;
        }
    }
</style>
