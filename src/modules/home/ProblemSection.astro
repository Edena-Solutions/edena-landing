---
import SectionHeader from "@/components/ds/SectionHeader.astro";
import type { Translation } from "@/i18n";

/*
 * The problem, then the turn. Three tiles say what a school juggles today, each with its stat set
 * large; below them every one of those tools floats loose, and as the page scrolls they fly into
 * Edena — the transition into "everything your school needs" that used to be a line diagram.
 */
interface Props {
    t: Translation;
}

const { t } = Astro.props;
const { problemSection } = t;

type Logo = { src: string; alt: string; invert?: boolean };

const toolLogos: Logo[] = [
    { src: "https://sinapsis.agency/uploads/images/2026/01/696c9f0aa8cff_c0ca1cb7.png", alt: problemSection.cards.tools.items[0] },
    {
        src: "https://upload.wikimedia.org/wikipedia/commons/a/a5/Google_Calendar_icon_%282020%29.svg",
        alt: problemSection.cards.tools.items[1],
    },
    {
        src: "https://upload.wikimedia.org/wikipedia/commons/9/9b/Google_Meet_icon_%282020%29.svg",
        alt: problemSection.cards.tools.items[2],
    },
    {
        src: "https://upload.wikimedia.org/wikipedia/commons/thumb/0/07/Microsoft_Office_Teams_%282025%E2%80%93present%29.svg/500px-Microsoft_Office_Teams_%282025%E2%80%93present%29.svg.png",
        alt: problemSection.cards.tools.items[3],
    },
];
const aiLogos: Logo[] = [
    { src: "https://cdn.worldvectorlogo.com/logos/openai-2.svg", alt: problemSection.cards.ai.items[0], invert: true },
    { src: "https://cdn.worldvectorlogo.com/logos/claude-logo.svg", alt: problemSection.cards.ai.items[1] },
    {
        src: "https://cdn.jsdelivr.net/npm/@lobehub/icons-static-svg@1.40.0/icons/gemini-color.svg",
        alt: problemSection.cards.ai.items[2],
    },
    {
        // The Wikipedia file this used to point at was deleted (404).
        src: "https://cdn.jsdelivr.net/npm/@lobehub/icons-static-svg@1.40.0/icons/copilot-color.svg",
        alt: problemSection.cards.ai.items[3],
    },
];
const financeLogos: Logo[] = [
    {
        src: "https://upload.wikimedia.org/wikipedia/commons/thumb/e/e3/Microsoft_Office_Excel_%282019%E2%80%932025%29.svg/3840px-Microsoft_Office_Excel_%282019%E2%80%932025%29.svg.png",
        alt: problemSection.cards.finance.items[0],
    },
    { src: "https://www.neobis.es/wp-content/uploads/2025/04/Sage_Logo.png", alt: problemSection.cards.finance.items[1] },
    { src: "https://davizgonzalez.com/wp-content/uploads/2024/11/holded-logo.webp", alt: problemSection.cards.finance.items[2] },
    {
        src: "https://upload.wikimedia.org/wikipedia/commons/thumb/5/59/SAP_2011_logo.svg/330px-SAP_2011_logo.svg.png",
        alt: problemSection.cards.finance.items[3],
    },
];

/** More SaaS brands in the converge scene only — the tiles above stay at four each. */
const extraSaasLogos: Logo[] = [
    { src: "https://cdn.worldvectorlogo.com/logos/slack-new-logo.svg", alt: problemSection.floatingExtras[0] },
    { src: "https://upload.wikimedia.org/wikipedia/commons/7/7e/Gmail_icon_%282020%29.svg", alt: problemSection.floatingExtras[1] },
    {
        src: "https://upload.wikimedia.org/wikipedia/commons/1/11/Zoom_Logo_2022.svg",
        alt: problemSection.floatingExtras[2],
    },
    { src: "https://upload.wikimedia.org/wikipedia/commons/e/e9/Notion-logo.svg", alt: problemSection.floatingExtras[3] },
    {
        src: "https://upload.wikimedia.org/wikipedia/commons/7/78/Dropbox_Icon.svg",
        alt: problemSection.floatingExtras[4],
    },
    {
        src: "https://upload.wikimedia.org/wikipedia/commons/3/3b/Asana_logo.svg",
        alt: problemSection.floatingExtras[5],
    },
    { src: "https://cdn.worldvectorlogo.com/logos/trello.svg", alt: problemSection.floatingExtras[6] },
    {
        src: "https://upload.wikimedia.org/wikipedia/commons/thumb/c/cc/Microsoft_Outlook_Icon_%282025%E2%80%93present%29.svg/960px-Microsoft_Outlook_Icon_%282025%E2%80%93present%29.svg.png",
        alt: problemSection.floatingExtras[7],
    },
];

/** The stat out of the highlight, wherever the language puts it ("73% de…", "Taldeen %73"). */
function splitStat(highlight: string) {
    const stat = highlight.match(/\S*\d\S*/)?.[0];
    if (!stat) return { stat: null, rest: highlight };
    return { stat, rest: highlight.replace(stat, "").replace(/\s+/g, " ").trim() };
}

const cards = [
    { ...problemSection.cards.tools, logos: toolLogos },
    { ...problemSection.cards.ai, logos: aiLogos },
    { ...problemSection.cards.finance, logos: financeLogos },
].map((card) => ({ ...card, ...splitStat(card.highlight) }));

/** Where each tool floats before it is pulled in: % of the stage, a tilt, and a depth. */
const scatter = [
    { x: 9, y: 22, r: -12, s: 1 },
    { x: 23, y: 72, r: 8, s: 0.9 },
    { x: 30, y: 20, r: 6, s: 0.78 },
    { x: 6, y: 64, r: 12, s: 0.74 },
    { x: 39, y: 84, r: -6, s: 0.84 },
    { x: 35, y: 46, r: -14, s: 0.68 },
    { x: 65, y: 40, r: 10, s: 0.72 },
    { x: 70, y: 16, r: -8, s: 0.92 },
    { x: 91, y: 26, r: 14, s: 0.8 },
    { x: 77, y: 72, r: -10, s: 1 },
    { x: 94, y: 68, r: 6, s: 0.74 },
    { x: 58, y: 86, r: 12, s: 0.86 },
    { x: 15, y: 48, r: -5, s: 0.76 },
    { x: 48, y: 14, r: 7, s: 0.82 },
    { x: 52, y: 62, r: -9, s: 0.7 },
    { x: 84, y: 52, r: 11, s: 0.88 },
    { x: 20, y: 90, r: 4, s: 0.72 },
    { x: 62, y: 28, r: -11, s: 0.78 },
    { x: 86, y: 82, r: 8, s: 0.66 },
    { x: 44, y: 36, r: -7, s: 0.9 },
];
const floating = [...toolLogos, ...aiLogos, ...financeLogos, ...extraSaasLogos].map((logo, index) => ({
    ...logo,
    ...scatter[index],
}));
const tilts = [-8, 5, -4, 9];
---

<section class="ds-section pb-0">
    <div class="ds-container">
        <SectionHeader
            title={problemSection.title}
            description={problemSection.description}
            mobileDescription={problemSection.mobileSummary}
        />

        <div class="ds-rail-frame mt-14">
        <div class="ds-rail ds-scroll-fade flex gap-3 md:grid md:grid-cols-3 md:gap-4" data-reveal-group>
            {
                cards.map((card) => (
                    <article class="ds-tile flex flex-col gap-8 p-7 sm:p-8" data-reveal="scale">
                        <div class="flex items-center pl-2">
                            {card.logos.map((logo, index) => (
                                <span
                                    class="-ml-2 flex size-12 items-center justify-center rounded-[0.85rem] bg-surface elev-2 ring-1 ring-hairline"
                                    style={`rotate:${tilts[index]}deg`}
                                >
                                    <img
                                        src={logo.src}
                                        alt={logo.alt}
                                        width="28"
                                        height="28"
                                        loading="lazy"
                                        decoding="async"
                                        class:list={["size-7 object-contain", logo.invert && "dark:invert"]}
                                    />
                                </span>
                            ))}
                        </div>
                        <div class="flex flex-col gap-3">
                            <h3 class="type-callout font-semibold text-ink">{card.title}</h3>
                            {card.stat && (
                                <p class="text-[3.25rem] font-semibold leading-none tracking-[-0.045em] text-ink">
                                    {card.stat}
                                </p>
                            )}
                            <p class="type-callout text-ink-2">
                                {card.rest && <strong class="font-semibold text-ink">{card.rest}</strong>}{" "}
                                {card.description}
                            </p>
                        </div>
                    </article>
                ))
            }
        </div>
        </div>
    </div>

    <div class="ds-converge-track mt-10" data-converge>
    <div
        class="ds-converge-stage mx-auto h-[28rem] w-full max-w-[92rem] sm:h-[38rem] lg:h-[44rem]"
        aria-hidden="true"
    >
        <svg class="ds-converge-threads" data-converge-threads preserveAspectRatio="none">
            <defs>
                <linearGradient id="ds-converge-thread-grad" gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="currentColor" stop-opacity="0.12"></stop>
                    <stop offset="72%" stop-color="currentColor" stop-opacity="0.28"></stop>
                    <stop offset="100%" stop-color="#22c55e" stop-opacity="0.55"></stop>
                </linearGradient>
            </defs>
            {floating.map(() => (
                <line class="ds-converge-thread" data-converge-thread stroke="url(#ds-converge-thread-grad)"></line>
            ))}
        </svg>
        {
            floating.map((logo, index) => (
                <div
                    class="absolute z-[2] -translate-x-1/2 -translate-y-1/2"
                    style={`left:${logo.x}%;top:${logo.y}%;transform:rotate(${logo.r}deg) scale(${logo.s})`}
                    data-converge-item
                >
                    <span
                        class:list={[
                            "flex size-14 animate-ds-float items-center justify-center rounded-[1rem] bg-surface elev-3 ring-1 ring-hairline sm:size-16 sm:rounded-[1.15rem] lg:size-[4.5rem]",
                            logo.s < 0.8 && "opacity-80 blur-[0.5px]",
                        ]}
                        style={`animation-delay:${-index * 0.8}s`}
                    >
                        <img
                            src={logo.src}
                            alt=""
                            width="40"
                            height="40"
                            loading="lazy"
                            decoding="async"
                            class:list={["size-8 object-contain sm:size-9 lg:size-10", logo.invert && "dark:invert"]}
                        />
                    </span>
                </div>
            ))
        }
        <div class="absolute z-[3] left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
            <div
                class="absolute inset-[-80%] rounded-full opacity-0 blur-3xl"
                style="background: var(--ds-brand-gradient)"
                data-converge-glow
            >
            </div>
            <span
                data-converge-bloom
                class="pointer-events-none absolute left-1/2 top-1/2 size-24 -translate-x-1/2 -translate-y-1/2 rounded-[1.6rem] opacity-0 ring-2 ring-hairline-strong sm:size-28 sm:rounded-[1.85rem] lg:size-32 lg:rounded-[2rem]"
            ></span>
            <div
                class="relative flex size-24 items-center justify-center rounded-[1.6rem] bg-surface elev-4 ring-1 ring-hairline sm:size-28 sm:rounded-[1.85rem] lg:size-32 lg:rounded-[2rem]"
                data-converge-core
            >
                <svg viewBox="0 0 30 29" class="size-12 text-ink sm:size-14 lg:size-16">
                    <path
                        fill="currentColor"
                        d="M26.9688 0C28.2809 0.000118162 29.3447 1.05184 29.3447 2.34863V26.6514C29.3447 27.9482 28.2809 28.9999 26.9688 29H2.37598C1.06375 28.9999 0 27.9482 0 26.6514V2.34863C0 1.0518 1.06375 5.61543e-05 2.37598 0H26.9688ZM4.79199 13.668C4.76544 13.9611 4.75196 14.2585 4.75195 14.5586C4.75195 20.0053 9.22002 24.4208 14.7314 24.4209C20.243 24.4209 24.7109 20.0054 24.7109 14.5586C24.7109 14.2225 24.6944 13.8899 24.6611 13.5625L4.79199 13.668ZM14.7314 4.69629C10.369 4.6964 6.6604 7.46288 5.30371 11.3174L24.124 11.2178C22.7389 7.41532 19.0563 4.69629 14.7314 4.69629Z"
                    ></path>
                </svg>
            </div>
        </div>
    </div>
    </div>
</section>
