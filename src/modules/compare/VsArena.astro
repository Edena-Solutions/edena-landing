---
/*
 * The stage the comparison pages open on: the product hero's light tile, with Ena's cyan in the
 * top-left corner and lime in the bottom-right. The face-off it hosts is a three-column grid — Edena, the
 * "VS" disc, the other — repeated row after row (marks, names, taglines) with the same columns, so
 * each name sits under its mark whatever its length. The classes are global to the stage so both
 * heroes share them.
 */
interface Props {
    class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={["vs-arena ds-tile relative isolate overflow-hidden text-ink", className]}>
    <div class="vs-aurora animate-ds-aurora" aria-hidden="true"></div>
    <slot />
</div>

<style>
    /*
     * Ena's two colours, a little of each: cyan in the top-left corner, lime in the bottom-right.
     * The layer bleeds past the tile so the blur is clipped by the card, not before it — otherwise
     * the lime fades out short of the corner.
     */
    .vs-aurora {
        position: absolute;
        z-index: -1;
        inset: -4rem;
        opacity: 0.95;
        filter: blur(18px);
        pointer-events: none;
        background:
            radial-gradient(ellipse 26rem 16rem at 3rem 2.25rem, rgb(34 211 238 / 0.62), transparent 72%),
            radial-gradient(
                ellipse 32rem 18rem at calc(100% - 4rem) calc(100% - 4rem),
                rgb(163 230 53 / 0.85) 0%,
                rgb(163 230 53 / 0.4) 32%,
                transparent 68%
            );
    }

    @media (prefers-reduced-motion: reduce) {
        .vs-aurora {
            animation: none;
        }
    }

    /* The face-off's columns: Edena, the disc, the other. */
    .vs-arena :global(.fo) {
        --vs-w: clamp(2.75rem, 1.6rem + 3vw, 5rem);
        display: grid;
        grid-template-columns: minmax(0, 1fr) var(--vs-w) minmax(0, 1fr);
        align-items: center;
        justify-items: center;
        column-gap: clamp(0.25rem, 1.5vw, 1.5rem);
        max-width: 50rem;
        margin-inline: auto;
    }

    .vs-arena :global(.fo-vs) {
        display: inline-grid;
        width: var(--vs-w);
        height: var(--vs-w);
        place-items: center;
        border-radius: 999px;
        background-color: var(--ds-surface);
        color: var(--ds-ink);
        font-size: calc(var(--vs-w) * 0.3);
        font-weight: 800;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        box-shadow:
            0 0 0 calc(var(--vs-w) * 0.14) color-mix(in srgb, var(--ds-ink) 4%, transparent),
            0 0 0 calc(var(--vs-w) * 0.28) color-mix(in srgb, var(--ds-ink) 2%, transparent),
            0 16px 32px -16px rgb(0 0 0 / 0.18);
    }

    .vs-arena :global(.fo-name) {
        max-width: 100%;
        padding-bottom: 0.08em;
        font-size: clamp(1.625rem, 0.9rem + 2.6vw, 3rem);
        font-weight: 800;
        line-height: 1.04;
        letter-spacing: -0.045em;
        text-wrap: balance;
        background-image: linear-gradient(
            to right,
            var(--ds-ink),
            color-mix(in srgb, var(--ds-ink) 40%, transparent)
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .vs-arena :global(.fo-tagline) {
        display: block;
        font-size: 0.875rem;
        line-height: 1.3rem;
        font-weight: 500;
        text-wrap: balance;
        color: var(--ds-ink-2);
    }

    .vs-arena :global(.fo-sub) {
        display: block;
        margin-top: 0.2rem;
        font-size: 0.75rem;
        line-height: 1.1rem;
        text-wrap: balance;
        color: var(--ds-ink-3);
    }

    /* Arriving: each contender from its own side, the disc landing between them. */
    @media (prefers-reduced-motion: no-preference) {
        .vs-arena :global(.fo-side--edena) {
            animation: fo-from-left 1.2s var(--ease-out-expo) 80ms both;
        }

        .vs-arena :global(.fo-side--rival) {
            animation: fo-from-right 1.2s var(--ease-out-expo) 160ms both;
        }

        .vs-arena :global(.fo-vs) {
            animation: fo-land 900ms var(--ease-spring-bounce) 480ms both;
        }
    }

    @keyframes fo-from-left {
        from {
            opacity: 0;
            transform: translate3d(-2.5rem, 0, 0) scale(0.94);
        }
    }

    @keyframes fo-from-right {
        from {
            opacity: 0;
            transform: translate3d(2.5rem, 0, 0) scale(0.94);
        }
    }

    @keyframes fo-land {
        from {
            opacity: 0;
            transform: scale(0.4) rotate(-18deg);
        }
    }
</style>
