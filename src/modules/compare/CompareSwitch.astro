---
import SectionHeader from "@/components/ds/SectionHeader.astro";
import type { Translation } from "@/i18n";
import { intlLocaleForLang } from "@/lib/intl-locale";

/*
 * What changing over takes, set out like the homepage results: one tall tile for the headline
 * figure, the rest as tiles beside it. Where those results draw activity rings, this draws the two
 * weeks on a calendar. On a phone the steps collapse into one panel, the number beside its line.
 */
interface Props {
    t: Translation;
    lang: string;
    /** Where they are coming from, named in the first step. */
    from: string;
}

const { t, lang, from } = Astro.props;
const c = t.comparePage;
const locale = intlLocaleForLang(lang);

const today = new Date();
today.setHours(12, 0, 0, 0);
const end = new Date(today);
end.setDate(today.getDate() + 13);

const monthStart = new Date(today.getFullYear(), today.getMonth(), 1, 12);
const leadIn = (monthStart.getDay() + 6) % 7;
const gridStart = new Date(monthStart);
gridStart.setDate(monthStart.getDate() - leadIn);

const cells = Array.from({ length: 42 }, (_, index) => {
    const day = new Date(gridStart);
    day.setDate(gridStart.getDate() + index);
    return day;
});
const weeks = Array.from({ length: 6 }, (_, index) => cells.slice(index * 7, index * 7 + 7)).filter((week) =>
    week.some((day) => day.getMonth() === today.getMonth() || (day >= today && day <= end)),
);

const monday = new Date(2026, 0, 5);
const weekdays = Array.from({ length: 7 }, (_, index) => {
    const day = new Date(monday);
    day.setDate(monday.getDate() + index);
    return new Intl.DateTimeFormat(locale, { weekday: "narrow" }).format(day);
});
const month = new Intl.DateTimeFormat(locale, { month: "long" }).format(today);
const sameDay = (a: Date, b: Date) => a.toDateString() === b.toDateString();
---

<section class="ds-section">
    <div class="ds-container">
        <SectionHeader title={c.switchTitle} description={c.switchDescription} />

        <div class="mt-10 grid grid-cols-2 gap-3 sm:mt-14 sm:gap-4 lg:grid-cols-4" data-reveal-group>
            <article class="ds-tile switch-lead col-span-2 lg:row-span-2" data-reveal="scale">
                <div class="switch-cal" aria-hidden="true">
                    <p class="switch-cal-month">{month}</p>
                    <div class="switch-cal-week">
                        {weekdays.map((day) => <span>{day}</span>)}
                    </div>
                    <div class="switch-cal-days">
                        {
                            weeks.flat().map((day) => (
                                <span
                                    class:list={[
                                        "switch-cal-day",
                                        day.getMonth() !== today.getMonth() && "is-out",
                                        day >= today && day <= end && "is-range",
                                        sameDay(day, today) && "is-start",
                                        sameDay(day, end) && "is-end",
                                    ]}
                                >
                                    {day.getDate()}
                                </span>
                            ))
                        }
                    </div>
                </div>
                <p class="switch-lead-value">
                    <span class="type-stat text-gradient-brand" data-count>{c.switchStat}</span>
                    <span class="switch-unit">{c.switchUnit}</span>
                </p>
                <p class="switch-lead-desc type-body text-ink-2">{c.switchCaption}</p>
            </article>

            <div class="switch-list col-span-2 sm:contents">
                {
                    c.switchSteps.map((step, index) => (
                        <article
                            class:list={["ds-tile switch-row", index === c.switchSteps.length - 1 && "sm:col-span-2"]}
                            data-reveal="scale"
                        >
                            <p class="switch-row-value font-semibold leading-none tracking-[-0.045em] text-ink">
                                {index + 1}
                            </p>
                            <div class="switch-row-copy">
                                <h3 class="switch-row-title">{step.title}</h3>
                                <p class="switch-row-desc text-ink-2">{step.body.replace("{name}", from)}</p>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>
    </div>
</section>

<style>
    /* The headline. A phone: the figure and the calendar side by side, the line under both. */
    .switch-lead {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-areas:
            "value cal"
            "desc desc";
        align-items: center;
        column-gap: 1rem;
        row-gap: 1rem;
        padding: 1.75rem;
    }

    .switch-cal {
        grid-area: cal;
        width: 8.75rem;
    }

    .switch-lead-value {
        grid-area: value;
        display: flex;
        min-width: 0;
        flex-direction: column;
        align-items: flex-start;
        margin: 0;
    }

    .switch-unit {
        margin-top: 0.15rem;
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: -0.03em;
        color: var(--ds-ink);
    }

    .switch-lead-desc {
        grid-area: desc;
        max-width: 28rem;
        margin: 0;
    }

    /* A tablet: the figure and its line on the left, the calendar large on the right. */
    @media (min-width: 40rem) {
        .switch-lead {
            grid-template-areas:
                "value cal"
                "desc cal";
            align-content: center;
            column-gap: 2.5rem;
            row-gap: 1rem;
            padding: 2.5rem;
        }

        .switch-lead-value {
            align-self: end;
        }

        .switch-lead-desc {
            align-self: start;
        }

        .switch-cal {
            width: 11rem;
        }
    }

    /* Wide: the tall tile, the calendar at its head and the figure at its foot. */
    @media (min-width: 64rem) {
        .switch-lead {
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: auto 1fr auto auto;
            grid-template-areas:
                "cal"
                "."
                "value"
                "desc";
            align-items: start;
            row-gap: 1rem;
            min-height: 22rem;
        }

        .switch-cal {
            width: 12.5rem;
        }
    }

    .switch-cal {
        padding: 0.55rem 0.4rem 0.45rem;
        border-radius: 1.125rem;
        background-color: var(--ds-surface);
        box-shadow: inset 0 0 0 1px var(--ds-hairline);
    }

    .switch-cal-month {
        margin: 0 0 0.3rem;
        font-size: 0.6875rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.01em;
        text-align: center;
        text-transform: capitalize;
        color: var(--ds-ink);
    }

    .switch-cal-week,
    .switch-cal-days {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
    }

    .switch-cal-week span {
        padding-block: 0.1rem;
        font-size: 0.5rem;
        font-weight: 600;
        line-height: 1;
        text-align: center;
        text-transform: uppercase;
        color: var(--ds-ink-3);
    }

    .switch-cal-day {
        display: grid;
        aspect-ratio: 1;
        place-items: center;
        font-size: 0.5625rem;
        font-weight: 600;
        line-height: 1;
        color: var(--ds-ink-2);
        border-radius: 999px;
    }

    .switch-cal-day.is-out {
        color: var(--ds-ink-3);
        opacity: 0.4;
    }

    .switch-cal-day.is-range {
        background-color: var(--ds-brand-soft);
        color: var(--ds-brand-ink);
        opacity: 1;
    }

    .switch-cal-day.is-start,
    .switch-cal-day.is-end {
        background-color: var(--ds-brand);
        color: #fff;
    }

    /* The steps. A phone: rows of one grouped panel, hairlines between them. */
    @media (max-width: 39.99rem) {
        .switch-list {
            display: flex;
            flex-direction: column;
            overflow: hidden;
            border-radius: var(--radius-tile);
            background-color: var(--ds-canvas-2);
        }

        .switch-row {
            display: grid;
            grid-template-columns: 3.25rem minmax(0, 1fr);
            align-items: center;
            column-gap: 1rem;
            padding: 1.15rem 1.5rem;
            border-radius: 0;
            background: none;
        }

        .switch-row + .switch-row::before {
            content: "";
            position: absolute;
            top: 0;
            right: 1.5rem;
            left: 1.5rem;
            height: 1px;
            background: var(--ds-hairline);
        }

        .switch-row-value {
            font-size: 1.875rem;
        }

        .switch-row-desc {
            font-size: 0.875rem;
            line-height: 1.4;
            text-wrap: pretty;
        }
    }

    /* From a tablet up: each its own tile, the figure at its head and the line at its foot. */
    @media (min-width: 40rem) {
        .switch-row {
            display: flex;
            min-height: 13rem;
            flex-direction: column;
            justify-content: space-between;
            gap: 1.5rem;
            padding: 1.75rem;
        }

        .switch-row-value {
            font-size: 3.25rem;
        }

        .switch-row-desc {
            font-size: 0.9375rem;
            line-height: 1.45;
        }
    }

    .switch-row-value,
    .switch-row-title,
    .switch-row-desc {
        margin: 0;
    }

    .switch-row-title {
        font-size: 1rem;
        font-weight: 600;
        line-height: 1.3;
        letter-spacing: -0.02em;
        color: var(--ds-ink);
    }

    .switch-row-desc {
        margin-top: 0.2rem;
        color: var(--ds-ink-2);
        text-wrap: pretty;
    }

    @media (min-width: 64rem) {
        .switch-row:last-child {
            flex-direction: row;
            align-items: center;
            justify-content: flex-start;
            gap: 1.75rem;
        }
    }
</style>
