---
import { CENTER_PACKS, PACKS, floorFor } from "@/constants/pricing";

/** Cheapest recommended entry across both catalogues — what "from …" may honestly claim. */
const cheapestEntry = Math.min(...[...PACKS, ...CENTER_PACKS].map((pack) => pack.pricePerStudent));
const entryPrice = floorFor(cheapestEntry, "academies");

/** Same sentence in every locale, with the entry price injected so it cannot drift from `price`. */
const OFFER_DESCRIPTION = {
    es: `Desde ${entryPrice} €/mes. Precio por alumno, sin cuota de alta ni permanencia.`,
    ca: `Des de ${entryPrice} €/mes. Preu per alumne, sense quota d'alta ni permanència.`,
    en: `From €${entryPrice}/month. Per-student pricing, no setup fee, no long-term contract.`,
    eus: `${entryPrice} €/hiletik. Ikasleko prezioa, alta-kuotarik eta iraunkortasunik gabe.`,
    fr: `Dès ${entryPrice} €/mois. Prix par élève, sans frais d'ouverture ni engagement.`,
} as const;
interface Props {
    lang?: string;
}

const { lang = "es" } = Astro.props;

const organizationSchema = {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://edena.es/#organization",
    name: "Edena",
    legalName: "Edena Software S.L.",
    url: "https://edena.es",
    logo: {
        "@type": "ImageObject",
        url: "https://edena.es/assets/img/logo.png",
        width: "200",
        height: "60",
    },
    description:
        lang === "es"
            ? "Edena es el ERP de gestión escolar para colegios, academias, escuelas infantiles y grupos educativos. Automatiza facturación, asistencia, comunicación familiar y matrículas en una sola plataforma. Certificado Verifactu AEAT."
            : lang === "fr"
              ? "Edena est l'ERP de gestion scolaire pour écoles, académies, crèches et groupes éducatifs. Automatise la facturation, les présences, la communication familiale et les inscriptions sur une seule plateforme."
              : lang === "ca"
                ? "Edena és l'ERP de gestió escolar per a col·legis, acadèmies, escoles infantils i grups educatius. Automatitza la facturació, l'assistència, la comunicació familiar i les matrícules en una sola plataforma."
                : "Edena is the school management ERP for schools, academies, nurseries and educational groups. Automates billing, attendance, family communication and enrolments in one platform.",
    foundingDate: "2022",
    address: {
        "@type": "PostalAddress",
        addressLocality: "Barcelona",
        addressRegion: "Cataluña",
        addressCountry: "ES",
    },
    areaServed: ["ES", "FR"],
    inLanguage: ["es-ES", "ca-ES", "eu", "en-US", "fr-FR"],
    knowsAbout: [
        "School management software",
        "ERP educativo",
        "Software gestión escolar",
        "Gestión de escuelas infantiles",
        "Software para academias",
        "Facturación escolar",
        "Verifactu facturación electrónica",
        "Portal de familias",
        "CRM escolar",
        "Control de asistencia escolar",
        "Expedientes digitales alumnos",
        "Gestión multi-centro educativo",
        "Student information system",
        "Family communication platform for schools",
        "Automated school billing SEPA",
    ],
    makesOffer: {
        "@type": "Offer",
        itemOffered: {
            "@type": "SoftwareApplication",
            "@id": "https://edena.es/#software",
            name: "Edena",
            applicationCategory: "EducationalApplication",
        },
        price: String(entryPrice),
        priceCurrency: "EUR",
        // Injected from the catalogue rather than written out: this object already carries the
        // figure in `price`, and a hand-typed one drifts out of step with it the first time a
        // floor moves. All five locales are covered — the previous two-branch ternary served
        // English to Catalan, Basque and French.
        description: OFFER_DESCRIPTION[lang as keyof typeof OFFER_DESCRIPTION ] ?? OFFER_DESCRIPTION.en,
    },
    contactPoint: {
        "@type": "ContactPoint",
        contactType: "customer service",
        email: "hola@edena.es",
        availableLanguage: ["Spanish", "Catalan", "English", "French", "Basque"],
    },
    // NOTE: add real profile URLs here (App Store, Google Play, LinkedIn) once
    // available. Placeholder store URLs were removed: pointing sameAs at
    // non-resolving pages hurts entity trust.
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
