---
import { Search, X } from "lucide-react";

/*
 * A search field in the premium pages' manner: a white pill with a hairline edge, the glass icon
 * inside, a clear button once something is typed, a green ring while in use. The page wires what
 * it filters (`data-search-input`, `data-search-clear`).
 */
interface Props {
    placeholder: string;
    clearLabel: string;
    class?: string;
}

const { placeholder, clearLabel, class: className } = Astro.props;
---

<div class:list={["ds-search", className]} role="search">
    <Search className="ds-search-icon" aria-hidden="true" />
    <input
        type="search"
        placeholder={placeholder}
        aria-label={placeholder}
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
        data-search-input
    />
    <button type="button" class="ds-search-clear" aria-label={clearLabel} data-search-clear hidden>
        <X aria-hidden="true" />
    </button>
</div>

<style>
    .ds-search {
        position: relative;
        display: flex;
        align-items: center;
        width: 100%;
        height: 3.25rem;
        border-radius: 999px;
        background-color: var(--ds-surface);
        box-shadow:
            inset 0 0 0 1px var(--ds-hairline),
            0 10px 30px -18px rgb(0 0 0 / 0.25);
        transition: box-shadow 200ms var(--ease-fluid);
    }

    .ds-search:hover {
        box-shadow:
            inset 0 0 0 1px var(--ds-hairline-strong),
            0 10px 30px -18px rgb(0 0 0 / 0.25);
    }

    .ds-search:focus-within {
        box-shadow:
            inset 0 0 0 1.5px var(--ds-brand),
            0 0 0 4px var(--ds-brand-soft),
            0 10px 30px -18px rgb(0 0 0 / 0.25);
    }

    .ds-search :global(.ds-search-icon) {
        position: absolute;
        left: 1.15rem;
        width: 1.125rem;
        height: 1.125rem;
        color: var(--ds-ink-3);
        pointer-events: none;
    }

    input {
        width: 100%;
        height: 100%;
        min-width: 0;
        border: 0;
        border-radius: inherit;
        background: transparent;
        padding: 0 3rem 0 2.9rem;
        font-size: 1rem;
        letter-spacing: -0.01em;
        color: var(--ds-ink);
        outline: none;
    }

    input::placeholder {
        color: var(--ds-ink-3);
    }

    input::-webkit-search-cancel-button,
    input::-webkit-search-decoration {
        appearance: none;
    }

    .ds-search-clear {
        position: absolute;
        right: 0.6rem;
        display: inline-flex;
        width: 2rem;
        height: 2rem;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background-color: var(--ds-fill-2);
        color: var(--ds-ink-2);
        cursor: pointer;
        transition: background-color 200ms var(--ease-fluid);
    }

    .ds-search-clear[hidden] {
        display: none;
    }

    .ds-search-clear:hover {
        background-color: var(--ds-fill);
    }

    .ds-search-clear :global(svg) {
        width: 0.95rem;
        height: 0.95rem;
    }
</style>
