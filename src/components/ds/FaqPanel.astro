---
import { ChevronDown } from "lucide-react";

/*
 * Questions and answers as one raised panel — the product pages' FAQ look — built on `<details>`:
 * every answer is in the page for readers and crawlers alike, it opens without JavaScript, and the
 * panel's `name` keeps one answer open at a time. Where the browser can animate to `auto`, the
 * answer unfolds on the spring.
 */
interface Props {
    items: { question: string; answer: string; id?: string }[];
    /** One answer open at a time within the panel. */
    name?: string;
    class?: string;
}

const { items, name, class: className } = Astro.props;
---

<div class:list={["faq-panel", className]}>
    {
        items.map((item) => (
            <details class="faq-item" name={name} id={item.id} data-faq-item>
                <summary>
                    <span class="faq-question">{item.question}</span>
                    <ChevronDown className="faq-chevron" aria-hidden="true" />
                </summary>
                <div class="faq-answer" set:html={item.answer} />
            </details>
        ))
    }
</div>

<style>
    .faq-panel {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: var(--radius-card);
        background-color: var(--ds-canvas-2);
        box-shadow: inset 0 0 0 1px var(--ds-hairline);
        interpolate-size: allow-keywords;
    }

    .faq-item {
        position: relative;
    }

    .faq-item[hidden] {
        display: none;
    }

    /* Hairlines between rows, inset from the question's edge. */
    .faq-item:not(:first-child)::before {
        content: "";
        position: absolute;
        top: 0;
        right: 0;
        left: 1.5rem;
        height: 1px;
        background: var(--ds-hairline);
        pointer-events: none;
    }

    summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.05rem 1.5rem;
        cursor: pointer;
        list-style: none;
        font-size: 1.0625rem;
        line-height: 1.4;
        letter-spacing: -0.018em;
        font-weight: 500;
        color: var(--ds-ink);
        text-wrap: pretty;
        transition: background-color 240ms var(--ease-fluid);
    }

    summary::-webkit-details-marker {
        display: none;
    }

    summary:hover {
        background-color: var(--ds-fill-2);
    }

    summary:active {
        background-color: color-mix(in srgb, var(--ds-fill) 82%, var(--ds-ink-3));
        transition-duration: 80ms;
    }

    summary:focus-visible {
        outline: none;
        box-shadow: inset 0 0 0 3px color-mix(in srgb, var(--ds-focus) 45%, transparent);
    }

    summary :global(.faq-chevron) {
        width: 1.125rem;
        height: 1.125rem;
        flex-shrink: 0;
        color: var(--ds-ink-3);
        transition: rotate 400ms var(--ease-spring);
    }

    .faq-item[open] summary :global(.faq-chevron) {
        rotate: 180deg;
    }

    .faq-answer {
        padding: 0 1.5rem 1.35rem;
        color: var(--ds-ink-2);
        font-size: 0.9375rem;
        line-height: 1.65;
        letter-spacing: -0.005em;
        text-wrap: pretty;
    }

    .faq-answer :global(:where(p, ul, ol)) {
        margin: 0;
    }

    .faq-answer :global(:where(p + p, p + ul, p + ol, ul + p, ol + p)) {
        margin-top: 0.75rem;
    }

    .faq-answer :global(ul) {
        list-style: disc;
        padding-left: 1.25rem;
    }

    .faq-answer :global(a) {
        color: var(--ds-ink);
        text-decoration: underline;
        text-underline-offset: 0.15em;
    }

    .faq-answer :global(a:hover) {
        color: var(--ds-ink-2);
    }

    /* The answer unfolds to its height and fades up, where `auto` can be animated. */
    @supports (interpolate-size: allow-keywords) {
        .faq-item::details-content {
            block-size: 0;
            overflow: clip;
            transition:
                block-size 460ms var(--ease-spring),
                content-visibility 460ms allow-discrete;
        }

        .faq-item[open]::details-content {
            block-size: auto;
        }

        .faq-answer {
            opacity: 0;
            translate: 0 -0.35rem;
            transition:
                opacity 320ms var(--ease-fluid),
                translate 460ms var(--ease-spring);
        }

        .faq-item[open] .faq-answer {
            opacity: 1;
            translate: 0 0;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .faq-item::details-content,
        .faq-answer,
        summary :global(.faq-chevron) {
            transition: none;
        }
    }
</style>
