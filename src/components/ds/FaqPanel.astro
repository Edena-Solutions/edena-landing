---
/*
 * Questions and answers as one raised panel — the product pages' FAQ look — built on `<details>`:
 * every answer is in the page for readers and crawlers alike, it opens without JavaScript, and the
 * panel's `name` keeps one answer open at a time.
 *
 * With scripting the panel animates itself, the same in every browser (CSS can only animate to
 * `auto` in Chromium): the answer unfolds to its height on the iOS sheet's curve while its text
 * rises into focus a beat behind, the one that was open folds away at the same time, and the "+"
 * beside each question turns into a "−" inside a disc that darkens. A second tap mid-animation
 * reverses it from where it is.
 */
interface Props {
    items: { question: string; answer: string; id?: string }[];
    /** One answer open at a time within the panel. */
    name?: string;
    class?: string;
}

const { items, name, class: className } = Astro.props;
---

<div class:list={["faq-panel", className]} data-faq-panel>
    {
        items.map((item) => (
            <details class="faq-item" name={name} id={item.id} data-faq-item>
                <summary>
                    <span class="faq-question">{item.question}</span>
                    <span class="faq-icon" aria-hidden="true">
                        <span class="faq-icon-bar" />
                        <span class="faq-icon-bar faq-icon-bar--v" />
                    </span>
                </summary>
                <div class="faq-body">
                    <div class="faq-answer" set:html={item.answer} />
                </div>
            </details>
        ))
    }
</div>

<script>
    const OPEN_EASE = "cubic-bezier(0.32, 0.72, 0, 1)";
    const CLOSE_EASE = "cubic-bezier(0.4, 0, 0.2, 1)";
    const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    type Running = { body: Animation; answer: Animation };
    const running = new WeakMap<HTMLDetailsElement, Running>();

    const parts = (details: HTMLDetailsElement) => ({
        body: details.querySelector<HTMLElement>(".faq-body")!,
        answer: details.querySelector<HTMLElement>(".faq-answer")!,
    });

    /** Stops whatever is moving on it and returns the height it had reached. */
    function halt(details: HTMLDetailsElement): number {
        const { body } = parts(details);
        const height = body.getBoundingClientRect().height;
        const current = running.get(details);
        if (current) {
            current.body.cancel();
            current.answer.cancel();
            running.delete(details);
        }
        return height;
    }

    function open(details: HTMLDetailsElement) {
        const { body, answer } = parts(details);
        const from = details.open ? halt(details) : 0;
        details.dataset.state = "open";
        details.open = true;
        if (reduceMotion()) return;

        const to = body.scrollHeight;
        const bodyAnimation = body.animate(
            [{ height: `${from}px` }, { height: `${to}px` }],
            { duration: 560, easing: OPEN_EASE },
        );
        const answerAnimation = answer.animate(
            [
                { opacity: 0, transform: "translateY(-0.6rem)", filter: "blur(2px)" },
                { opacity: 1, transform: "none", filter: "blur(0)" },
            ],
            { duration: 520, delay: 70, easing: OPEN_EASE, fill: "backwards" },
        );
        running.set(details, { body: bodyAnimation, answer: answerAnimation });
        bodyAnimation.onfinish = () => running.delete(details);
    }

    function close(details: HTMLDetailsElement) {
        const { body, answer } = parts(details);
        const from = halt(details);
        details.dataset.state = "closed";
        if (reduceMotion()) {
            details.open = false;
            return;
        }

        const bodyAnimation = body.animate(
            [{ height: `${from}px` }, { height: "0px" }],
            { duration: 380, easing: CLOSE_EASE, fill: "forwards" },
        );
        const answerAnimation = answer.animate(
            [
                { opacity: 1, transform: "none" },
                { opacity: 0, transform: "translateY(-0.35rem)" },
            ],
            { duration: 200, easing: CLOSE_EASE, fill: "forwards" },
        );
        running.set(details, { body: bodyAnimation, answer: answerAnimation });
        bodyAnimation.onfinish = () => {
            details.open = false;
            bodyAnimation.cancel();
            answerAnimation.cancel();
            running.delete(details);
        };
    }

    function setupFaqPanels() {
        document.querySelectorAll<HTMLElement>("[data-faq-panel]:not([data-ready])").forEach((panel) => {
            panel.dataset.ready = "";
            const items = [...panel.querySelectorAll<HTMLDetailsElement>("[data-faq-item]")];
            // The panel keeps one answer open itself: the native `name` would close the other one
            // instantly, before it could fold away.
            const exclusive = items.some((details) => details.hasAttribute("name"));
            items.forEach((details) => {
                details.removeAttribute("name");
                details.dataset.state = details.open ? "open" : "closed";
                // Opened from elsewhere (a link to a question): its state follows.
                details.addEventListener("toggle", () => {
                    if (!running.has(details)) details.dataset.state = details.open ? "open" : "closed";
                });
                details.querySelector("summary")?.addEventListener("click", (event) => {
                    event.preventDefault();
                    if (details.dataset.state === "open") {
                        close(details);
                        return;
                    }
                    if (exclusive) {
                        items.forEach((other) => other !== details && other.dataset.state === "open" && close(other));
                    }
                    open(details);
                });
            });
        });
    }

    document.addEventListener("astro:page-load", setupFaqPanels);
</script>

<style>
    .faq-panel {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border-radius: var(--radius-card);
        background-color: var(--ds-canvas-2);
        box-shadow: inset 0 0 0 1px var(--ds-hairline);
    }

    .faq-item {
        position: relative;
    }

    .faq-item[hidden] {
        display: none;
    }

    /* Hairlines between rows, inset from the question's edge. */
    .faq-item:not(:first-child)::before {
        content: "";
        position: absolute;
        top: 0;
        right: 1.5rem;
        left: 1.5rem;
        height: 1px;
        background: var(--ds-hairline);
        pointer-events: none;
    }

    summary {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.25rem;
        padding: 1.15rem 1.25rem 1.15rem 1.5rem;
        cursor: pointer;
        list-style: none;
        font-size: 1.0625rem;
        line-height: 1.4;
        letter-spacing: -0.018em;
        font-weight: 500;
        color: var(--ds-ink);
        text-wrap: pretty;
        -webkit-tap-highlight-color: transparent;
        transition: background-color 300ms var(--ease-fluid);
    }

    summary::-webkit-details-marker {
        display: none;
    }

    @media (hover: hover) {
        summary:hover {
            background-color: var(--ds-fill-2);
        }
    }

    summary:active {
        background-color: color-mix(in srgb, var(--ds-fill) 82%, var(--ds-ink-3));
        transition-duration: 80ms;
    }

    summary:focus-visible {
        outline: none;
        box-shadow: inset 0 0 0 3px color-mix(in srgb, var(--ds-focus) 45%, transparent);
    }

    /* "+" in a soft disc; open, the disc darkens and the "+" lays its upright down into a "−". */
    .faq-icon {
        position: relative;
        display: inline-grid;
        width: 1.75rem;
        height: 1.75rem;
        flex-shrink: 0;
        place-items: center;
        border-radius: 999px;
        background-color: var(--ds-fill-2);
        color: var(--ds-ink-2);
        transition:
            background-color 420ms var(--ease-fluid),
            color 420ms var(--ease-fluid),
            rotate 520ms var(--ease-fluid);
    }

    .faq-icon-bar {
        grid-area: 1 / 1;
        width: 0.7rem;
        height: 1.5px;
        border-radius: 999px;
        background-color: currentColor;
        transition: rotate 520ms var(--ease-fluid);
    }

    .faq-icon-bar--v {
        rotate: 90deg;
    }

    .faq-item:is([open]:not([data-state]), [data-state="open"]) .faq-icon {
        rotate: 180deg;
        background-color: var(--ds-ink);
        color: var(--ds-canvas);
    }

    .faq-item:is([open]:not([data-state]), [data-state="open"]) .faq-icon-bar--v {
        rotate: 0deg;
    }

    .faq-body {
        overflow: hidden;
    }

    .faq-answer {
        padding: 0 4.25rem 1.4rem 1.5rem;
        color: var(--ds-ink-2);
        font-size: 0.9375rem;
        line-height: 1.65;
        letter-spacing: -0.005em;
        text-wrap: pretty;
        will-change: transform, opacity;
    }

    @media (max-width: 39.99rem) {
        .faq-answer {
            padding-right: 1.5rem;
        }
    }

    .faq-answer :global(:where(p, ul, ol)) {
        margin: 0;
    }

    .faq-answer :global(:where(p + p, p + ul, p + ol, ul + p, ol + p)) {
        margin-top: 0.75rem;
    }

    .faq-answer :global(ul) {
        list-style: disc;
        padding-left: 1.25rem;
    }

    .faq-answer :global(a) {
        color: var(--ds-ink);
        text-decoration: underline;
        text-underline-offset: 0.15em;
    }

    .faq-answer :global(a:hover) {
        color: var(--ds-ink-2);
    }

    @media (prefers-reduced-motion: reduce) {
        summary,
        .faq-icon,
        .faq-icon-bar {
            transition: none;
        }
    }
</style>
