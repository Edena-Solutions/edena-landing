---
import type { Translation } from "@/i18n";
import { APP_STORE_URL, GOOGLE_PLAY_URL } from "@/constants/app-stores";
import { cn } from "@/lib/utils";

interface Props {
    t: Translation;
    iosUrl?: string;
    androidUrl?: string;
    className?: string;
}

const {
    t,
    iosUrl = APP_STORE_URL,
    androidUrl = GOOGLE_PLAY_URL,
    className,
} = Astro.props;
---

<div class={cn("flex flex-row gap-3 items-center", className)}>
    {
        iosUrl && (
            <a href={iosUrl} target="_blank" rel="noopener noreferrer" class="inline-block">
                <img
                    src="https://tools.applemediaservices.com/api/badges/download-on-the-app-store/black/en-us?size=250x83&releaseDate=1288569600"
                    alt={t.altText.appStoreBadge}
                    class="h-9 w-auto"
                />
            </a>
        )
    }
    {
        androidUrl && (
            <a href={androidUrl} target="_blank" rel="noopener noreferrer" class="inline-block">
                <img
                    src="https://upload.wikimedia.org/wikipedia/commons/thumb/7/78/Google_Play_Store_badge_EN.svg/960px-Google_Play_Store_badge_EN.svg.png"
                    alt={t.altText.googlePlayBadge}
                    class="h-9 w-auto"
                />
            </a>
        )
    }
</div>
