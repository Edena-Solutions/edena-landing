---
import type { Translation } from "@/i18n";
import { APP_STORE_URL, GOOGLE_PLAY_URL } from "@/constants/app-stores";
import { cn } from "@/lib/utils";
import { BRAND_LOGOS } from "@/data/brandLogos";

interface Props {
    t: Translation;
    iosUrl?: string;
    androidUrl?: string;
    className?: string;
}

const {
    t,
    iosUrl = APP_STORE_URL,
    androidUrl = GOOGLE_PLAY_URL,
    className,
} = Astro.props;
---

<div class={cn("flex flex-row gap-3 items-center", className)}>
    {
        iosUrl && (
            <a href={iosUrl} target="_blank" rel="noopener noreferrer" class="inline-block">
                <img
                    src={BRAND_LOGOS.appStoreBadge.src}
                    alt={t.altText.appStoreBadge}
                    class="h-9 w-auto"
                />
            </a>
        )
    }
    {
        androidUrl && (
            <a href={androidUrl} target="_blank" rel="noopener noreferrer" class="inline-block">
                <img
                    src={BRAND_LOGOS.googlePlayBadge.src}
                    alt={t.altText.googlePlayBadge}
                    class="h-9 w-auto"
                />
            </a>
        )
    }
</div>
