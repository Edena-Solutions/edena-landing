---
import { BILLING_FLOOR } from "@/constants/pricing";
import { translations, localeStaticPaths, localePath, localizedDemoPath } from "@/i18n/index.ts";
import Layout from "@/layouts/main.astro";
import Hero from "@/modules/pricing/Hero.astro";
import { PricingPacks } from "@/components/PricingPacks";
import { AcademyModulesTable } from "@/components/AcademyModulesTable";
import GSAPSection from "@/components/ui/gsap-section";
import ProductSchema from "@/components/StructuredData/Product.astro";
import BreadcrumbListSchema from "@/components/StructuredData/BreadcrumbList.astro";
import { PACKS } from "@/constants/pricing";
import { homeBreadcrumbName } from "@/lib/breadcrumb";
import { ogFromAsset } from "@/lib/og-image";
import pricingOgImage from "@/assets/img/screenshots/finance/billing_cycle.png";
import Conclusion from "@/modules/home/Conclusion.astro";

export function getStaticPaths() {
    return localeStaticPaths();
}

const REGISTER_URL = "https://app.edena.es/register-organization";

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
const base = "https://edena.es";
const pageUrl = `${base}${localePath(lang, "/pricing/academies")}`;

/** One offer per pack, priced per enrolled student. */
const offers = PACKS.map((pack) => ({
    price: pack.pricePerStudent.toFixed(2),
    priceCurrency: "EUR",
    availability: "https://schema.org/InStock",
    url: pageUrl,
}));

const breadcrumbs = [
    { name: homeBreadcrumbName(lang), url: `${base}${localePath(lang, "/")}` },
    { name: t.navigation.pricing, url: `${base}${localePath(lang, "/pricing")}` },
    { name: t.navigation.pricingAcademies, url: pageUrl },
];
---

<Layout
    content={{
        title: t.meta.pricingAcademiesTitle,
        description: t.meta.pricingAcademiesDescription,
        ...ogFromAsset(pricingOgImage, Astro.site),
    }}
    lang={lang}
>
    <Fragment slot="structured-data">
        <ProductSchema
            name="Edena - Packs para academias"
            description={t.meta.pricingAcademiesDescription}
            offers={offers}
            category="Software de Gestión para Academias"
            lang={lang}
        />
        <BreadcrumbListSchema items={breadcrumbs} lang={lang} />
    </Fragment>
    <section class="grid gap-16 px-4 w-full mx-auto">
        <Hero t={t} title={t.pricing.packs.title} description={t.pricing.packs.description} />
        <p class="text-center text-[10px] tracking-widest uppercase text-muted-foreground">
            {t.pricing.packs.minNote.replace("{n}", String(BILLING_FLOOR.academies.value))}
        </p>
        <PricingPacks
            client:load
            t={t}
            lang={lang}
            demoUrl={localizedDemoPath(lang)}
            registerUrl={REGISTER_URL}
        />
        <GSAPSection client:load className="flex flex-col gap-10 w-full">
            <div class="flex flex-col gap-4 text-center">
                <h2
                    class="text-xl sm:text-3xl font-bold bg-gradient-to-r from-foreground to-foreground/40 bg-clip-text text-transparent max-w-lg sm:max-w-2xl text-center mx-auto"
                >
                    {t.pricing.packs.comparisonTitle}
                </h2>
                <p class="text-muted-foreground max-w-2xl mx-auto">
                    {t.pricing.packs.comparisonDescription}
                </p>
            </div>
            <div class="mx-auto w-full max-w-5xl">
                <AcademyModulesTable t={t} />
            </div>
        </GSAPSection>
        <Conclusion lang={lang} />
    </section>
</Layout>
