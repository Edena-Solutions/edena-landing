---
import { BILLING_FLOOR, PACKS, moduleSectionsById, type PlanFeatureSection } from "@/constants/pricing";
import { translations, localeStaticPaths, localePath, localizedDemoPath } from "@/i18n/index.ts";
import Layout from "@/layouts/main.astro";
import HomeMotion from "@/modules/home/HomeMotion.astro";
import ClosingCta from "@/modules/home/ClosingCta.astro";
import PageHero from "@/modules/product/PageHero.astro";
import AcademyPacks from "@/modules/pricing/AcademyPacks";
import AcademyCompare from "@/modules/pricing/AcademyCompare.astro";
import PricingNotes from "@/modules/pricing/PricingNotes.astro";
import ProductSchema from "@/components/StructuredData/Product.astro";
import BreadcrumbListSchema from "@/components/StructuredData/BreadcrumbList.astro";
import { homeBreadcrumbName } from "@/lib/breadcrumb";
import { ogFromAsset } from "@/lib/og-image";
import pricingOgImage from "@/assets/img/screenshots/finance/billing_cycle.png";

/*
 * Academy pricing, in the home's design: the three packs under a monthly/annual switch, what every
 * plan includes, and a table of what each module does and which packs carry it.
 */

export function getStaticPaths() {
    return localeStaticPaths();
}

const REGISTER_URL = "https://app.edena.es/register-organization";

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
const base = "https://edena.es";
const pageUrl = `${base}${localePath(lang, "/pricing/academies")}`;
const sections = moduleSectionsById((t.pricing as { planFeatureSections?: PlanFeatureSection[] }).planFeatureSections ?? []);

/** One offer per pack, priced per enrolled student. */
const offers = PACKS.map((pack) => ({
    price: pack.pricePerStudent.toFixed(2),
    priceCurrency: "EUR",
    availability: "https://schema.org/InStock",
    url: pageUrl,
}));

const breadcrumbs = [
    { name: homeBreadcrumbName(lang), url: `${base}${localePath(lang, "/")}` },
    { name: t.navigation.pricing, url: `${base}${localePath(lang, "/pricing")}` },
    { name: t.navigation.pricingAcademies, url: pageUrl },
];

const copy = {
    items: t.pricing.packs.items,
    includes: t.pricing.packs.includes,
    bestFor: t.pricing.packs.bestFor,
    perStudent: t.pricing.perStudent,
    mostPopular: t.pricing.mostPopular,
    monthly: t.pricing.calculator.monthly,
    annual: t.pricing.calculator.annual,
    annualDiscount: t.pricing.calculator.annualDiscount,
    bookDemo: t.bookDemo,
    startNow: t.pricing.startNow,
    modules: Object.fromEntries(Object.entries(sections).map(([id, section]) => [id, section.title])),
    tokens: t.pricingPage.tokensPerMonth,
};
---

<Layout
    content={{
        title: t.meta.pricingAcademiesTitle,
        description: t.meta.pricingAcademiesDescription,
        ...ogFromAsset(pricingOgImage, Astro.site),
    }}
    lang={lang}
    design="premium"
>
    <Fragment slot="structured-data">
        <ProductSchema
            name="Edena - Packs para academias"
            description={t.meta.pricingAcademiesDescription}
            offers={offers}
            category="Software de Gestión para Academias"
            lang={lang}
        />
        <BreadcrumbListSchema items={breadcrumbs} lang={lang} />
    </Fragment>
    <HomeMotion />
    <PageHero
        eyebrow={t.navigation.pricing}
        eyebrowHref={localePath(lang, "/pricing")}
        title={t.pricing.packs.title}
        description={t.pricing.packs.description}
    >
        <p class="ds-intro mt-4 type-footnote text-ink-3" style="--intro-i: 2">
            {t.pricing.packs.minNote.replace("{n}", String(BILLING_FLOOR.academies.value))}
        </p>
    </PageHero>
    <section class="ds-section pt-12 sm:pt-16">
        <div class="ds-container flex flex-col gap-4">
            <div data-reveal="rise">
                <AcademyPacks client:load copy={copy} lang={lang} demoUrl={localizedDemoPath(lang)} registerUrl={REGISTER_URL} />
            </div>
            <div class="mt-6">
                <PricingNotes t={t} />
            </div>
        </div>
    </section>
    <AcademyCompare t={t} lang={lang} />
    <ClosingCta lang={lang} />
</Layout>
