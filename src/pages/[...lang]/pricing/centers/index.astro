---
import { translations, localeStaticPaths, localePath, localizedDemoPath } from "@/i18n/index.ts";
import Layout from "@/layouts/main.astro";
import HomeMotion from "@/modules/home/HomeMotion.astro";
import ClosingCta from "@/modules/home/ClosingCta.astro";
import PageHero from "@/modules/product/PageHero.astro";
import CentersPricing from "@/modules/pricing/CentersPricing.astro";
import ProductSchema from "@/components/StructuredData/Product.astro";
import BreadcrumbListSchema from "@/components/StructuredData/BreadcrumbList.astro";
import { CENTER_PACKS, floorFor } from "@/constants/pricing";
import { homeBreadcrumbName } from "@/lib/breadcrumb";

export function getStaticPaths() {
    return localeStaticPaths();
}

const REGISTER_URL = "https://app.edena.es/register-organization";

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
const base = "https://edena.es";
const pageUrl = `${base}${localePath(lang, "/pricing/centers")}`;

/** Modular plans start at the monthly billing floor. */
const offers = [
    {
        price: String(floorFor(CENTER_PACKS[0].pricePerStudent, "centers")),
        priceCurrency: "EUR",
        availability: "https://schema.org/InStock",
        url: pageUrl,
    },
];

const breadcrumbs = [
    { name: homeBreadcrumbName(lang), url: `${base}${localePath(lang, "/")}` },
    { name: t.navigation.pricing, url: `${base}${localePath(lang, "/pricing")}` },
    { name: t.navigation.pricingCenters, url: pageUrl },
];
---

<Layout
    content={{
        title: t.meta.pricingCentersTitle,
        description: t.meta.pricingCentersDescription,
    }}
    lang={lang}
    design="premium"
>
    <Fragment slot="structured-data">
        <ProductSchema
            name={t.schema.pricingCenters}
            description={t.meta.pricingCentersDescription}
            offers={offers}
            category={t.schema.categorySchools}
            lang={lang}
        />
        <BreadcrumbListSchema items={breadcrumbs} lang={lang} />
    </Fragment>
    <HomeMotion />
    <PageHero title={t.pricing.centers.title} description={t.pricing.centers.description} />
    <CentersPricing
        t={t}
        lang={lang}
        demoUrl={localizedDemoPath(lang)}
        registerUrl={REGISTER_URL}
    />
    <ClosingCta lang={lang} />
</Layout>
