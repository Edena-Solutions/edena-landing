---
import { translations, localeStaticPaths, localePath } from "@/i18n/index.ts";
import Layout from "@/layouts/main.astro";
import HomeMotion from "@/modules/home/HomeMotion.astro";
import FeatureGrid from "@/modules/home/FeatureGrid.astro";
import ClosingCta from "@/modules/home/ClosingCta.astro";
import ProductHero from "@/modules/product/ProductHero.astro";
import ProductSplit from "@/modules/product/ProductSplit.astro";
import ProductFaqs from "@/modules/product/ProductFaqs.astro";
import ExtracurricularScenes from "@/modules/product/scenes/ExtracurricularScenes";
import { productSceneLabels } from "@/modules/product/scenes/labels";
import { intlLocaleForLang } from "@/lib/intl-locale";
import SoftwareApplicationSchema from "@/components/StructuredData/SoftwareApplication.astro";
import FAQPageSchema from "@/components/StructuredData/FAQPage.astro";

export function getStaticPaths() {
    return localeStaticPaths();
}

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
const labels = { ...productSceneLabels(t), x: t.extracurricularScenes };
const locale = intlLocaleForLang(lang);
const m = t.productModules.extracurricular;

const icons = [
    "MousePointerClick",
    "Users",
    "CreditCard",
    "ClipboardCheck",
    "CalendarClock",
    "BarChart2",
];
const featureLinks = ["/app", "/crm", "/finance", "/students", "/tracking", "/dashboard"];
const features = m.features.map((f, i) => ({
    icon: icons[i],
    title: f.title,
    description: f.description,
    navigateTo: localePath(lang, featureLinks[i] ?? "/demo"),
}));
---

<Layout
    content={{
        title: m.metaTitle,
        description: m.metaDescription,
    }}
    lang={lang}
    design="premium"
>
    <HomeMotion />
    <ProductHero t={t} title={m.mainTitle} description={m.mainDescription} bleed>
        <ExtracurricularScenes slot="visual" client:visible scene="catalog" labels={labels} locale={locale} />
    </ProductHero>
    <ProductSplit
        t={t}
        left={{ title: m.heroLeftTitle, description: m.heroLeftDescription, cta: true, bleed: true }}
        right={{ title: m.heroRightTitle, description: m.heroRightDescription, bleed: true }}
    >
        <ExtracurricularScenes slot="left" client:visible scene="browse" labels={labels} locale={locale} />
        <ExtracurricularScenes slot="right" client:visible scene="detail" labels={labels} locale={locale} />
    </ProductSplit>
    <FeatureGrid t={t} features={features} title={m.featuresTitle} description={m.featuresDescription} />
    <ProductSplit
        t={t}
        title={m.sectionTitle}
        description={m.sectionDescription}
        left={{ title: m.section1Title, description: m.section1Description, bleed: true }}
        right={{ title: m.section2Title, description: m.section2Description, bleed: true }}
    >
        <ExtracurricularScenes slot="left" client:visible scene="enrol" labels={labels} locale={locale} />
        <ExtracurricularScenes slot="right" client:visible scene="agenda" labels={labels} locale={locale} />
    </ProductSplit>
    <ProductFaqs t={t} title={m.faqTitle} description={m.faqDescription} faqs={m.faqs} />
    <ClosingCta lang={lang} />
    <SoftwareApplicationSchema
        slot="structured-data"
        name="Edena - Extraescolares"
        description={m.metaDescription}
        applicationCategory="EducationalApplication"
        operatingSystem={["Web", "iOS", "Android"]}
        url={`https://edena.es/${lang}/extracurricular`}
        lang={lang}
    />
    <FAQPageSchema slot="structured-data" faqs={m.faqs} translations={{}} lang={lang} />
</Layout>
