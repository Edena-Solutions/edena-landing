---
import { translations, localeStaticPaths, localePath } from "@/i18n/index.ts";

import Layout from "@/layouts/main.astro";
import HomeMotion from "@/modules/home/HomeMotion.astro";
import FeatureGrid from "@/modules/home/FeatureGrid.astro";
import ClosingCta from "@/modules/home/ClosingCta.astro";
import ProductHero from "@/modules/product/ProductHero.astro";
import ProductSplit from "@/modules/product/ProductSplit.astro";
import ProductFaqs from "@/modules/product/ProductFaqs.astro";
import AcademiesScenes from "@/modules/product/scenes/AcademiesScenes";
import CrmScenes from "@/modules/product/scenes/CrmScenes";
import { productSceneLabels } from "@/modules/product/scenes/labels";
import { intlLocaleForLang } from "@/lib/intl-locale";
import SoftwareApplicationSchema from "@/components/StructuredData/SoftwareApplication.astro";
import FAQPageSchema from "@/components/StructuredData/FAQPage.astro";
import { getCollection } from "astro:content";

export function getStaticPaths() {
    return localeStaticPaths();
}

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
const base = productSceneLabels(t);
const labels = { ...base, ac: t.academiesScenes };
const locale = intlLocaleForLang(lang);

const faqsCollection = await getCollection("faqs");
const academiesFaqs = faqsCollection.find((entry) => entry.id === "faqsAcademies.md");

const features = [
    {
        icon: "Target",
        title: t.features.crmFeatures.pipeline.title,
        description: t.features.crmFeatures.pipeline.tagline,
        navigateTo: localePath(lang, "/crm"),
    },
    {
        icon: "CreditCard",
        title: t.features.centersFeatures.automatedBilling.title,
        description: t.features.centersFeatures.automatedBilling.tagline,
        navigateTo: localePath(lang, "/finance"),
    },
    {
        icon: "Users",
        title: t.features.centersFeatures.studentManagement.title,
        description: t.features.centersFeatures.studentManagement.tagline,
        navigateTo: localePath(lang, "/students"),
    },
    {
        icon: "ClipboardList",
        title: t.features.studentFeatures.attendanceTracking.title,
        description: t.features.studentFeatures.attendanceTracking.tagline,
        navigateTo: localePath(lang, "/extracurricular"),
    },
    {
        icon: "Bell",
        title: t.features.appFeatures.mobileNotifications.title,
        description: t.features.appFeatures.mobileNotifications.tagline,
        navigateTo: localePath(lang, "/app"),
    },
    {
        icon: "BarChart3",
        title: t.features.crmFeatures.reports.title,
        description: t.features.crmFeatures.reports.tagline,
        navigateTo: localePath(lang, "/crm"),
    },
];
---

<Layout
    content={{
        title: t.meta.academiesTitle,
        description: t.meta.academiesDescription,
    }}
    lang={lang}
    design="premium"
>
    <HomeMotion />
    <ProductHero t={t} title={t.academies.mainTitle} description={t.academies.mainDescription} bleed>
        <AcademiesScenes slot="visual" client:visible scene="today" labels={labels} locale={locale} />
    </ProductHero>
    <ProductSplit
        t={t}
        left={{ title: t.academies.communicationTitle, description: t.academies.communicationDescription, cta: true, bleed: true }}
        right={{ title: t.academies.automationTitle, description: t.academies.automationDescription, bleed: true }}
    >
        <CrmScenes slot="left" client:visible scene="pipeline" labels={base} locale={locale} />
        <AcademiesScenes slot="right" client:visible scene="rates" labels={labels} locale={locale} />
    </ProductSplit>
    <FeatureGrid t={t} features={features} title={t.academies.integratedManagementTitle} description={t.academies.integratedManagementDescription} />
    <ProductSplit
        t={t}
        title={t.academies.dailyLifeSectionTitle}
        description={t.academies.dailyLifeSectionDescription}
        left={{ title: t.academies.realTimeCommunicationTitle, description: t.academies.realTimeCommunicationDescription, bleed: true }}
        right={{ title: t.academies.financialAutomationTitle, description: t.academies.financialAutomationDescription, bleed: true }}
    >
        <AcademiesScenes slot="left" client:visible scene="notices" labels={labels} locale={locale} />
        <AcademiesScenes slot="right" client:visible scene="bundle" labels={labels} locale={locale} />
    </ProductSplit>
    <ProductFaqs
        t={t}
        title={t.faqs.academies?.title ?? t.faqs.title}
        description={t.faqs.academies?.description ?? t.faqs.description}
        faqs={academiesFaqs?.data.faqs ?? []}
    />
    <ClosingCta lang={lang} />
    <SoftwareApplicationSchema
        slot="structured-data"
        name="Edena - Software para Academias"
        description={t.meta.academiesDescription}
        applicationCategory="EducationalApplication"
        operatingSystem={["Web", "iOS", "Android"]}
        url={`https://edena.es/${lang}/academies`}
        lang={lang}
    />
    {
        academiesFaqs?.data.faqs && (
            <FAQPageSchema
                slot="structured-data"
                faqs={academiesFaqs.data.faqs}
                translations={t.faqs}
                lang={lang}
            />
        )
    }
</Layout>
