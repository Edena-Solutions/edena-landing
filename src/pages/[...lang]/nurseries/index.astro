---
import { translations, localeStaticPaths, localePath } from "@/i18n/index.ts";

import Layout from "@/layouts/main.astro";
import HomeMotion from "@/modules/home/HomeMotion.astro";
import FeatureGrid from "@/modules/home/FeatureGrid.astro";
import ClosingCta from "@/modules/home/ClosingCta.astro";
import ProductHero from "@/modules/product/ProductHero.astro";
import ProductSplit from "@/modules/product/ProductSplit.astro";
import ProductFaqs from "@/modules/product/ProductFaqs.astro";
import NurseriesScenes from "@/modules/product/scenes/NurseriesScenes";
import AppScenes from "@/modules/product/scenes/AppScenes";
import FinanceScenes from "@/modules/product/scenes/FinanceScenes";
import { productSceneLabels } from "@/modules/product/scenes/labels";
import { intlLocaleForLang } from "@/lib/intl-locale";
import SoftwareApplicationSchema from "@/components/StructuredData/SoftwareApplication.astro";
import FAQPageSchema from "@/components/StructuredData/FAQPage.astro";
import { getCollection } from "astro:content";

export function getStaticPaths() {
    return localeStaticPaths();
}

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
const base = productSceneLabels(t);
const labels = { ...base, nu: t.nurseriesScenes };
const locale = intlLocaleForLang(lang);

const faqsCollection = await getCollection("faqs");
const nurseriesFaqs = faqsCollection.find((entry) => entry.id === "faqsNurseries.md");

const features = [
    {
        icon: "MessageCircle",
        title: t.features.centersFeatures.communicationHub.title,
        description: t.features.centersFeatures.communicationHub.tagline,
        navigateTo: localePath(lang, "/communication"),
    },
    {
        icon: "CreditCard",
        title: t.features.centersFeatures.automatedBilling.title,
        description: t.features.centersFeatures.automatedBilling.tagline,
        navigateTo: localePath(lang, "/finance"),
    },
    {
        icon: "Smartphone",
        title: t.features.appFeatures.parentPortal.title,
        description: t.features.appFeatures.parentPortal.tagline,
        navigateTo: localePath(lang, "/families"),
    },
    {
        icon: "Bell",
        title: t.features.appFeatures.mobileNotifications.title,
        description: t.features.appFeatures.mobileNotifications.tagline,
        navigateTo: localePath(lang, "/communication"),
    },
    {
        icon: "Users",
        title: t.features.centersFeatures.studentManagement.title,
        description: t.features.centersFeatures.studentManagement.tagline,
        navigateTo: localePath(lang, "/students"),
    },
    {
        icon: "Shield",
        title: t.features.centersFeatures.dataSecurity.title,
        description: t.features.centersFeatures.dataSecurity.tagline,
        navigateTo: localePath(lang, "/data-processing"),
    },
];
---

<Layout
    content={{
        title: t.meta.nurseryTitle,
        description: t.meta.nurseryDescription,
    }}
    lang={lang}
    design="premium"
>
    <HomeMotion />
    <ProductHero t={t} eyebrow={t.pageEyebrows.nurseries} title={t.nurseries.mainTitle} description={t.nurseries.mainDescription} bleed>
        <NurseriesScenes slot="visual" client:visible scene="agenda" labels={labels} locale={locale} />
    </ProductHero>
    <ProductSplit
        t={t}
        left={{ title: t.nurseries.communicationTitle, description: t.nurseries.communicationDescription, cta: true, bleed: true }}
        right={{ title: t.nurseries.automationTitle, description: t.nurseries.automationDescription, bleed: true }}
    >
        <AppScenes slot="left" client:visible scene="album" labels={base} locale={locale} />
        <FinanceScenes slot="right" client:visible scene="cycle" labels={base} locale={locale} />
    </ProductSplit>
    <FeatureGrid t={t} features={features} title={t.nurseries.integratedManagementTitle} description={t.nurseries.integratedManagementDescription} actions />
    <ProductSplit
        t={t}
        title={t.nurseries.dailyLifeSectionTitle}
        description={t.nurseries.dailyLifeSectionDescription}
        left={{ title: t.nurseries.realTimeCommunicationTitle, description: t.nurseries.realTimeCommunicationDescription, bleed: true, cta: "demo" }}
        right={{ title: t.nurseries.childrenManagementTitle, description: t.nurseries.childrenManagementDescription, bleed: true, cta: "trial" }}
    >
        <NurseriesScenes slot="left" client:visible scene="feed" labels={labels} locale={locale} />
        <NurseriesScenes slot="right" client:visible scene="child" labels={labels} locale={locale} />
    </ProductSplit>
    <ProductFaqs
        t={t}
        title={t.faqs.nurseries?.title ?? t.faqs.title}
        description={t.faqs.nurseries?.description ?? t.faqs.description}
        faqs={nurseriesFaqs?.data.faqs ?? []}
    />
    <ClosingCta lang={lang} />
    <SoftwareApplicationSchema
        slot="structured-data"
        name={t.schema.nurseries}
        description={t.meta.nurseryDescription}
        applicationCategory="EducationalApplication"
        operatingSystem={["Web", "iOS", "Android"]}
        url={`https://edena.es/${lang}/nurseries`}
        lang={lang}
    />
    {
        nurseriesFaqs?.data.faqs && (
            <FAQPageSchema
                slot="structured-data"
                faqs={nurseriesFaqs.data.faqs}
                translations={t.faqs}
                lang={lang}
            />
        )
    }
</Layout>
