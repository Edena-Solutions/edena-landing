---
import { translations, localeStaticPaths, localePath } from "@/i18n/index.ts";
import { getCollection } from "astro:content";
import Layout from "@/layouts/main.astro";
import HomeMotion from "@/modules/home/HomeMotion.astro";
import FeatureGrid from "@/modules/home/FeatureGrid.astro";
import ClosingCta from "@/modules/home/ClosingCta.astro";
import ProductHero from "@/modules/product/ProductHero.astro";
import ProductSplit from "@/modules/product/ProductSplit.astro";
import ProductFaqs from "@/modules/product/ProductFaqs.astro";
import CrmScenes from "@/modules/product/scenes/CrmScenes";
import { productSceneLabels } from "@/modules/product/scenes/labels";
import SoftwareApplicationSchema from "@/components/StructuredData/SoftwareApplication.astro";
import FAQPageSchema from "@/components/StructuredData/FAQPage.astro";
import { intlLocaleForLang } from "@/lib/intl-locale";

/*
 * The CRM's page, in the home's design: its screens drawn and brought to life rather than
 * screenshotted (`scenes/CrmScenes.tsx`), each playing once as it comes into view.
 */

export function getStaticPaths() {
    return localeStaticPaths();
}

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
const labels = productSceneLabels(t);
const locale = intlLocaleForLang(lang);

const faqsCollection = await getCollection("faqs");
const crmFaqs = faqsCollection.find((entry) => entry.id === "faqsCrm.md");

const features = [
    {
        icon: "GitBranch",
        title: t.features.crmFeatures.pipeline.title,
        description: t.features.crmFeatures.pipeline.tagline,
        navigateTo: localePath(lang, "/demo"),
    },
    {
        icon: "FileEdit",
        title: t.features.crmFeatures.forms.title,
        description: t.features.crmFeatures.forms.tagline,
        navigateTo: localePath(lang, "/workflows"),
    },
    {
        icon: "Activity",
        title: t.features.crmFeatures.activity.title,
        description: t.features.crmFeatures.activity.tagline,
        navigateTo: localePath(lang, "/dashboard"),
    },
    {
        icon: "UserPlus",
        title: t.features.crmFeatures.assignment.title,
        description: t.features.crmFeatures.assignment.tagline,
        navigateTo: localePath(lang, "/tracking"),
    },
    {
        icon: "Globe",
        title: t.features.crmFeatures.origin.title,
        description: t.features.crmFeatures.origin.tagline,
        navigateTo: localePath(lang, "/communication"),
    },
    {
        icon: "BarChart2",
        title: t.features.crmFeatures.reports.title,
        description: t.features.crmFeatures.reports.tagline,
        navigateTo: localePath(lang, "/dashboard"),
    },
];
---

<Layout
    content={{
        title: t.meta.crmTitle,
        description: t.meta.crmDescription,
    }}
    lang={lang}
    design="premium"
>
    <HomeMotion />
    <ProductHero t={t} title={t.crm.mainTitle} description={t.crm.mainDescription} bleed>
        <CrmScenes slot="visual" client:visible scene="pipeline" labels={labels} locale={locale} />
    </ProductHero>
    <ProductSplit
        t={t}
        left={{
            title: t.crm.requestsTitle,
            description: t.crm.requestsDescription,
            cta: true,
            bleed: true,
        }}
        right={{
            title: t.crm.heroRightCardTitle,
            description: t.crm.heroRightCardDescription,
            bleed: true,
        }}
    >
        <CrmScenes slot="left" client:visible scene="requests" labels={labels} locale={locale} />
        <CrmScenes slot="right" client:visible scene="enquiry" labels={labels} locale={locale} />
    </ProductSplit>
    <FeatureGrid
        t={t}
        features={features}
        title={t.features.crmFeatures.title}
        description={t.features.crmFeatures.tagline}
        actions
    />
    <ProductSplit
        t={t}
        title={t.crm.formsAndPipelineTitle}
        description={t.crm.formsAndPipelineDescription}
        left={{
            title: t.crm.formTitle,
            description: t.crm.formDescription,
            bleed: true,
            cta: "demo",
        }}
        right={{
            title: t.crm.pipelineTitle,
            description: t.crm.pipelineDescription,
            bleed: true,
            cta: "trial",
        }}
    >
        <CrmScenes slot="left" client:visible scene="editor" labels={labels} locale={locale} />
        <CrmScenes slot="right" client:visible scene="stages" labels={labels} locale={locale} />
    </ProductSplit>
    <ProductFaqs
        t={t}
        title={t.faqs.crm?.title ?? t.faqs.title}
        description={t.faqs.crm?.description ?? t.faqs.description}
        faqs={crmFaqs?.data.faqs ?? []}
    />
    <ClosingCta lang={lang} />
    <SoftwareApplicationSchema
        slot="structured-data"
        name={t.schema.crm}
        description={t.meta.crmDescription}
        applicationCategory="EducationalApplication"
        operatingSystem={["Web", "iOS", "Android"]}
        url={`https://edena.es/${lang}/crm`}
        lang={lang}
    />
    {
        crmFaqs?.data.faqs && (
            <FAQPageSchema
                slot="structured-data"
                faqs={crmFaqs.data.faqs}
                translations={t.faqs}
                lang={lang}
            />
        )
    }
</Layout>
