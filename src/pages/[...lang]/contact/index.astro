---
import { translations, localeStaticPaths } from "@/i18n/index.ts";
import Layout from "@/layouts/main.astro";
import { ContactForm } from "@/components/ContactForm";
import HomeMotion from "@/modules/home/HomeMotion.astro";
import ClosingCta from "@/modules/home/ClosingCta.astro";
import PageHero from "@/modules/product/PageHero.astro";

/*
 * Contact, in the home's design: the question, then the form — who is writing on the left, what
 * they need on the right — and the closing call underneath.
 */

export function getStaticPaths() {
    return localeStaticPaths();
}

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
---

<Layout content={{ title: t.meta.contactTitle, description: t.meta.contactDescription }} lang={lang} design="premium">
    <HomeMotion />
    <PageHero eyebrow={t.pageEyebrows.contact} title={t.contact.title} description={t.contact.description} />
    <section class="ds-section pt-12 sm:pt-16">
        <div class="ds-container" data-reveal="rise">
            <ContactForm client:load copy={t.contact} formspreeUrl={"https://formspree.io/f/mykbqoeq"} />
        </div>
    </section>
    <ClosingCta lang={lang} />
</Layout>
