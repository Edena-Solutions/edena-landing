---
import { translations, localeStaticPaths, localePath } from "@/i18n/index.ts";
import { getCollection } from "astro:content";
import Layout from "@/layouts/main.astro";
import HomeMotion from "@/modules/home/HomeMotion.astro";
import FeatureGrid from "@/modules/home/FeatureGrid.astro";
import ClosingCta from "@/modules/home/ClosingCta.astro";
import ProductHero from "@/modules/product/ProductHero.astro";
import ProductSplit from "@/modules/product/ProductSplit.astro";
import ProductFaqs from "@/modules/product/ProductFaqs.astro";
import AppScenes from "@/modules/product/scenes/AppScenes";
import { productSceneLabels } from "@/modules/product/scenes/labels";
import DownloadAppIcons from "@/components/DownloadAppIcons";
import SoftwareApplicationSchema from "@/components/StructuredData/SoftwareApplication.astro";
import FAQPageSchema from "@/components/StructuredData/FAQPage.astro";
import { intlLocaleForLang } from "@/lib/intl-locale";

/*
 * The families' app's page, in the home's design: the app drawn on phones of glass and brought to
 * life rather than screenshotted (`scenes/AppScenes.tsx`), each scene playing once as it comes into
 * view.
 */

export function getStaticPaths() {
    return localeStaticPaths();
}
const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
const labels = productSceneLabels(t);
const locale = intlLocaleForLang(lang);

const faqsCollection = await getCollection("faqs");
const appFaqs = faqsCollection.find((entry) => entry.id === "faqsApp.md");

const features = [
    {
        icon: "Bell",
        title: t.features.appFeatures.mobileNotifications.title,
        description: t.features.appFeatures.mobileNotifications.tagline,
        navigateTo: localePath(lang, "/communication"),
    },
    {
        icon: "Wifi",
        title: t.features.appFeatures.offlineAccess.title,
        description: t.features.appFeatures.offlineAccess.tagline,
        navigateTo: localePath(lang, "/families"),
    },
    {
        icon: "Users",
        title: t.features.appFeatures.parentPortal.title,
        description: t.features.appFeatures.parentPortal.tagline,
        navigateTo: localePath(lang, "/families"),
    },
    {
        icon: "BookOpen",
        title: t.features.appFeatures.teacherTools.title,
        description: t.features.appFeatures.teacherTools.tagline,
        navigateTo: localePath(lang, "/dashboard"),
    },
    {
        icon: "Trophy",
        title: t.features.appFeatures.studentEngagement.title,
        description: t.features.appFeatures.studentEngagement.tagline,
        navigateTo: localePath(lang, "/students"),
    },
    {
        icon: "Lock",
        title: t.features.appFeatures.secureMessaging.title,
        description: t.features.appFeatures.secureMessaging.tagline,
        navigateTo: localePath(lang, "/communication"),
    },
];
---

<Layout
    content={{
        title: t.meta.appTitle,
        description: t.meta.appDescription,
    }}
    lang={lang}
    design="premium"
>
    <HomeMotion />
    <ProductHero t={t} title={t.app.mainTitle} description={t.app.mainDescription} bleed>
        <AppScenes slot="visual" client:visible scene="trio" labels={labels} locale={locale} max={60} />
    </ProductHero>
    <ProductSplit
        t={t}
        left={{
            title: t.app.parentsConnectedTitle,
            description: t.app.parentsConnectedDescription,
            cta: true,
            bleed: true,
        }}
        right={{
            title: t.app.androidIosTitle,
            description: t.app.androidIosDescription,
            bleed: true,
        }}
    >
        <AppScenes slot="left" client:visible scene="chat" labels={labels} locale={locale} />
        <div slot="right" class="flex w-full flex-col items-center gap-2">
            <DownloadAppIcons lang={lang} quiet className="flex flex-col items-center" />
            <AppScenes client:visible scene="stores" labels={labels} locale={locale} />
        </div>
    </ProductSplit>
    <FeatureGrid
        t={t}
        features={features}
        title={t.features.appFeatures.title}
        description={t.features.appFeatures.tagline}
    />
    <ProductSplit
        t={t}
        title={t.app.uploadPicturesTitle}
        description={t.app.uploadPicturesDescription}
        left={{
            title: t.app.communicateAndGetAlbumsTitle,
            description: t.app.communicateAndGetAlbumsDescription,
            bleed: true,
        }}
        right={{
            title: t.app.uploadPicturesAndVideosTitle,
            description: t.app.uploadPicturesAndVideosDescription,
            bleed: true,
        }}
    >
        <AppScenes slot="left" client:visible scene="album" labels={labels} locale={locale} />
        <AppScenes slot="right" client:visible scene="updates" labels={labels} locale={locale} />
    </ProductSplit>
    <ProductFaqs
        t={t}
        title={t.faqs.app?.title ?? t.faqs.title}
        description={t.faqs.app?.description ?? t.faqs.description}
        faqs={appFaqs?.data.faqs ?? []}
    />
    <ClosingCta lang={lang} />
    <SoftwareApplicationSchema
        slot="structured-data"
        name="Edena"
        description={t.meta.appDescription}
        applicationCategory="EducationalApplication"
        operatingSystem={["iOS", "Android", "Web"]}
        url={`https://edena.es/${lang}/app`}
        lang={lang}
        aggregateRating={{
            ratingValue: "4.8",
            reviewCount: "150",
        }}
    />
    {
        appFaqs?.data.faqs && (
            <FAQPageSchema
                slot="structured-data"
                faqs={appFaqs.data.faqs}
                translations={t.faqs}
                lang={lang}
            />
        )
    }
</Layout>
