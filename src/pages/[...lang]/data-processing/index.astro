---
import { translations, localeStaticPaths } from "@/i18n/index.ts";
import Layout from "@/layouts/main.astro";
import LegalDocument from "@/modules/legal/LegalDocument.astro";

export function getStaticPaths() {
    return localeStaticPaths();
}

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
---

<Layout content={{ title: t.meta.dpaTitle, description: t.meta.dpaDescription }} lang={lang} design="premium">
    <LegalDocument t={t} lang={lang} title={t.dataProcessingAgreement.title} content={t.dataProcessingAgreement.content} current="dpa" />
</Layout>
