---
import { translations, localeStaticPaths, localePath } from "@/i18n/index.ts";

import Layout from "@/layouts/main.astro";
import HomeMotion from "@/modules/home/HomeMotion.astro";
import FeatureGrid from "@/modules/home/FeatureGrid.astro";
import ClosingCta from "@/modules/home/ClosingCta.astro";
import ProductHero from "@/modules/product/ProductHero.astro";
import ProductSplit from "@/modules/product/ProductSplit.astro";
import ProductFaqs from "@/modules/product/ProductFaqs.astro";
import SchoolsScenes from "@/modules/product/scenes/SchoolsScenes";
import CommunicationScenes from "@/modules/product/scenes/CommunicationScenes";
import AssignmentScenes from "@/modules/product/scenes/AssignmentScenes";
import FinanceScenes from "@/modules/product/scenes/FinanceScenes";
import { productSceneLabels } from "@/modules/product/scenes/labels";
import { intlLocaleForLang } from "@/lib/intl-locale";
import SoftwareApplicationSchema from "@/components/StructuredData/SoftwareApplication.astro";
import FAQPageSchema from "@/components/StructuredData/FAQPage.astro";
import { getCollection } from "astro:content";

export function getStaticPaths() {
    return localeStaticPaths();
}

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
const base = productSceneLabels(t);
const labels = { ...base, sc: t.schoolsScenes };
const communicationLabels = { ...base, c: t.communicationScenes };
const assignmentLabels = { ...base, as: t.assignmentScenes };
const locale = intlLocaleForLang(lang);

const faqsCollection = await getCollection("faqs");
const schoolsFaqs = faqsCollection.find((entry) => entry.id === "faqsSchools.md");

const features = [
    {
        icon: "GraduationCap",
        title: t.features.studentFeatures.digitalRecords.title,
        description: t.features.studentFeatures.digitalRecords.tagline,
        navigateTo: localePath(lang, "/students"),
    },
    {
        icon: "ClipboardList",
        title: t.features.studentFeatures.attendanceTracking.title,
        description: t.features.studentFeatures.attendanceTracking.tagline,
        navigateTo: localePath(lang, "/students"),
    },
    {
        icon: "BookOpen",
        title: t.features.assignmentFeatures.gradeManagement.title,
        description: t.features.assignmentFeatures.gradeManagement.tagline,
        navigateTo: localePath(lang, "/assignment"),
    },
    {
        icon: "FileText",
        title: t.features.assignmentFeatures.automatedReports.title,
        description: t.features.assignmentFeatures.automatedReports.tagline,
        navigateTo: localePath(lang, "/assignment"),
    },
    {
        icon: "CreditCard",
        title: t.features.centersFeatures.automatedBilling.title,
        description: t.features.centersFeatures.automatedBilling.tagline,
        navigateTo: localePath(lang, "/finance"),
    },
    {
        icon: "MessageCircle",
        title: t.features.centersFeatures.communicationHub.title,
        description: t.features.centersFeatures.communicationHub.tagline,
        navigateTo: localePath(lang, "/communication"),
    },
];
---

<Layout
    content={{
        title: t.meta.schoolsTitle,
        description: t.meta.schoolsDescription,
    }}
    lang={lang}
    design="premium"
>
    <HomeMotion />
    <ProductHero t={t} title={t.schools.mainTitle} description={t.schools.mainDescription} bleed>
        <SchoolsScenes slot="visual" client:visible scene="year" labels={labels} locale={locale} />
    </ProductHero>
    <ProductSplit
        t={t}
        left={{ title: t.schools.communicationTitle, description: t.schools.communicationDescription, cta: true, bleed: true }}
        right={{ title: t.schools.automationTitle, description: t.schools.automationDescription, bleed: true }}
    >
        <CommunicationScenes slot="left" client:visible scene="channels" labels={communicationLabels} locale={locale} />
        <AssignmentScenes slot="right" client:visible scene="gradebook" labels={assignmentLabels} locale={locale} />
    </ProductSplit>
    <FeatureGrid t={t} features={features} title={t.schools.integratedManagementTitle} description={t.schools.integratedManagementDescription} actions />
    <ProductSplit
        t={t}
        title={t.schools.familyAndBillingSectionTitle}
        description={t.schools.familyAndBillingSectionDescription}
        left={{ title: t.schools.realTimeCommunicationTitle, description: t.schools.realTimeCommunicationDescription, bleed: true, cta: "demo" }}
        right={{ title: t.schools.financialAutomationTitle, description: t.schools.financialAutomationDescription, bleed: true, cta: "trial" }}
    >
        <SchoolsScenes slot="left" client:visible scene="family" labels={labels} locale={locale} />
        <FinanceScenes slot="right" client:visible scene="breakdown" labels={base} locale={locale} />
    </ProductSplit>
    <ProductFaqs
        t={t}
        title={t.faqs.schools?.title ?? t.faqs.title}
        description={t.faqs.schools?.description ?? t.faqs.description}
        faqs={schoolsFaqs?.data.faqs ?? []}
    />
    <ClosingCta lang={lang} />
    <SoftwareApplicationSchema
        slot="structured-data"
        name={t.schema.schools}
        description={t.meta.schoolsDescription}
        applicationCategory="EducationalApplication"
        operatingSystem={["Web", "iOS", "Android"]}
        url={`https://edena.es/${lang}/schools`}
        lang={lang}
    />
    {
        schoolsFaqs?.data.faqs && (
            <FAQPageSchema
                slot="structured-data"
                faqs={schoolsFaqs.data.faqs}
                translations={t.faqs}
                lang={lang}
            />
        )
    }
</Layout>
