---
import { translations, localeStaticPaths, localePath } from "@/i18n/index.ts";
import Layout from "@/layouts/main.astro";
import HomeMotion from "@/modules/home/HomeMotion.astro";
import FeatureGrid from "@/modules/home/FeatureGrid.astro";
import ClosingCta from "@/modules/home/ClosingCta.astro";
import ProductHero from "@/modules/product/ProductHero.astro";
import ProductSplit from "@/modules/product/ProductSplit.astro";
import ProductFaqs from "@/modules/product/ProductFaqs.astro";
import StudentsScenes from "@/modules/product/scenes/StudentsScenes";
import { productSceneLabels } from "@/modules/product/scenes/labels";
import { intlLocaleForLang } from "@/lib/intl-locale";
import SoftwareApplicationSchema from "@/components/StructuredData/SoftwareApplication.astro";
import FAQPageSchema from "@/components/StructuredData/FAQPage.astro";
import { getCollection } from "astro:content";

export function getStaticPaths() {
    return localeStaticPaths();
}
const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
const base = productSceneLabels(t);
const labels = { ...base, st: t.studentsScenes };
const locale = intlLocaleForLang(lang);

const faqsCollection = await getCollection("faqs");
const studentsFaqs = faqsCollection.find((entry) => entry.id === "faqsStudents.md");

const features = [
    {
        icon: "FolderOpen",
        title: t.features.studentFeatures.digitalRecords.title,
        description: t.features.studentFeatures.digitalRecords.tagline,
        navigateTo: localePath(lang, "/families"),
    },
    {
        icon: "UserCheck",
        title: t.features.studentFeatures.attendanceTracking.title,
        description: t.features.studentFeatures.attendanceTracking.tagline,
        navigateTo: localePath(lang, "/app"),
    },
    {
        icon: "BarChart3",
        title: t.features.studentFeatures.gradeManagement.title,
        description: t.features.studentFeatures.gradeManagement.tagline,
        navigateTo: localePath(lang, "/assignment"),
    },
    {
        icon: "Calendar",
        title: t.features.studentFeatures.scheduleOptimization.title,
        description: t.features.studentFeatures.scheduleOptimization.tagline,
        navigateTo: localePath(lang, "/tracking"),
    },
    {
        icon: "TrendingUp",
        title: t.features.studentFeatures.behaviorTracking.title,
        description: t.features.studentFeatures.behaviorTracking.tagline,
        navigateTo: localePath(lang, "/communication"),
    },
    {
        icon: "FileText",
        title: t.features.studentFeatures.academicReports.title,
        description: t.features.studentFeatures.academicReports.tagline,
        navigateTo: localePath(lang, "/dashboard"),
    },
];
---

<Layout
    content={{
        title: t.meta.studentsTitle,
        description: t.meta.studentsDescription,
    }}
    lang={lang}
    design="premium"
>
    <HomeMotion />
    <ProductHero t={t} title={t.students.mainTitle} description={t.students.mainDescription} bleed>
        <StudentsScenes slot="visual" client:visible scene="record" labels={labels} locale={locale} />
    </ProductHero>
    <ProductSplit
        t={t}
        left={{ title: t.students.studentInvoicingTitle, description: t.students.studentInvoicingDescription, cta: true, bleed: true }}
        right={{ title: t.students.studentDetailTitle, description: t.students.studentDetailDescription, bleed: true }}
    >
        <StudentsScenes slot="left" client:visible scene="billing" labels={labels} locale={locale} />
        <StudentsScenes slot="right" client:visible scene="grades" labels={labels} locale={locale} />
    </ProductSplit>
    <FeatureGrid t={t} features={features} title={t.features.studentFeatures.title} description={t.features.studentFeatures.tagline} />
    <ProductSplit
        t={t}
        title={t.students.organizationTitle}
        description={t.students.organizationDescription}
        left={{ title: t.students.classroomsTitle, description: t.students.classroomsDescription, bleed: true }}
        right={{ title: t.students.classroomsDetailsTitle, description: t.students.classroomsDetailsDescription, bleed: true }}
    >
        <StudentsScenes slot="left" client:visible scene="structure" labels={labels} locale={locale} />
        <StudentsScenes slot="right" client:visible scene="classroom" labels={labels} locale={locale} />
    </ProductSplit>
    <ProductFaqs
        t={t}
        title={t.faqs.students?.title ?? t.faqs.title}
        description={t.faqs.students?.description ?? t.faqs.description}
        faqs={studentsFaqs?.data.faqs ?? []}
    />
    <ClosingCta lang={lang} />
    <SoftwareApplicationSchema
        slot="structured-data"
        name="Edena - Sistema de Información Estudiantil"
        description={t.meta.studentsDescription}
        applicationCategory="EducationalApplication"
        operatingSystem={["Web", "iOS", "Android"]}
        url={`https://edena.es/${lang}/students`}
        lang={lang}
    />
    {
        studentsFaqs?.data.faqs && (
            <FAQPageSchema
                slot="structured-data"
                faqs={studentsFaqs.data.faqs}
                translations={t.faqs}
                lang={lang}
            />
        )
    }
</Layout>
