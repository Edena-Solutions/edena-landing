---
import { translations, localeStaticPaths, localePath } from "@/i18n/index.ts";
import Layout from "@/layouts/main.astro";
import HomeMotion from "@/modules/home/HomeMotion.astro";
import FeatureGrid from "@/modules/home/FeatureGrid.astro";
import ClosingCta from "@/modules/home/ClosingCta.astro";
import ProductHero from "@/modules/product/ProductHero.astro";
import ProductSplit from "@/modules/product/ProductSplit.astro";
import ProductFaqs from "@/modules/product/ProductFaqs.astro";
import TrackingScenes from "@/modules/product/scenes/TrackingScenes";
import { productSceneLabels } from "@/modules/product/scenes/labels";
import { intlLocaleForLang } from "@/lib/intl-locale";
import SoftwareApplicationSchema from "@/components/StructuredData/SoftwareApplication.astro";
import FAQPageSchema from "@/components/StructuredData/FAQPage.astro";

export function getStaticPaths() {
    return localeStaticPaths();
}

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
const labels = { ...productSceneLabels(t), tr: t.trackingScenes };
const locale = intlLocaleForLang(lang);
const m = t.productModules.tracking;

const icons = ["Clock", "CalendarDays", "ListChecks", "UserCheck", "FileBarChart", "Bell"];
const featureLinks = ["/dashboard", "/communication", "/workflows", "/demo", "/finance", "/communication"];
const features = m.features.map((f, i) => ({
    icon: icons[i],
    title: f.title,
    description: f.description,
    navigateTo: localePath(lang, featureLinks[i] ?? "/demo"),
}));
---

<Layout
    content={{
        title: m.metaTitle,
        description: m.metaDescription,
    }}
    lang={lang}
    design="premium"
>
    <HomeMotion />
    <ProductHero t={t} eyebrow={t.pageEyebrows.tracking} title={m.mainTitle} description={m.mainDescription} bleed>
        <TrackingScenes slot="visual" client:visible scene="reports" labels={labels} locale={locale} />
    </ProductHero>
    <ProductSplit
        t={t}
        left={{ title: m.heroLeftTitle, description: m.heroLeftDescription, cta: true, bleed: true }}
        right={{ title: m.heroRightTitle, description: m.heroRightDescription, bleed: true }}
    >
        <TrackingScenes slot="left" client:visible scene="clockin" labels={labels} locale={locale} />
        <TrackingScenes slot="right" client:visible scene="today" labels={labels} locale={locale} />
    </ProductSplit>
    <FeatureGrid t={t} features={features} title={m.featuresTitle} description={m.featuresDescription} actions />
    <ProductSplit
        t={t}
        title={m.sectionTitle}
        description={m.sectionDescription}
        left={{ title: m.section1Title, description: m.section1Description, bleed: true, cta: "demo" }}
        right={{ title: m.section2Title, description: m.section2Description, bleed: true, cta: "trial" }}
    >
        <TrackingScenes slot="left" client:visible scene="timesheet" labels={labels} locale={locale} />
        <TrackingScenes slot="right" client:visible scene="week" labels={labels} locale={locale} />
    </ProductSplit>
    <ProductFaqs t={t} title={m.faqTitle} description={m.faqDescription} faqs={m.faqs} />
    <ClosingCta lang={lang} />
    <SoftwareApplicationSchema
        slot="structured-data"
        name={t.schema.tracking}
        description={m.metaDescription}
        applicationCategory="EducationalApplication"
        operatingSystem={["Web", "iOS", "Android"]}
        url={`https://edena.es/${lang}/tracking`}
        lang={lang}
    />
    <FAQPageSchema slot="structured-data" faqs={m.faqs} translations={{}} lang={lang} />
</Layout>
