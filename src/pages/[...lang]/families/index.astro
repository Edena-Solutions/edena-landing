---
import { translations, localeStaticPaths, localePath } from "@/i18n/index.ts";

import Layout from "@/layouts/main.astro";
import HomeMotion from "@/modules/home/HomeMotion.astro";
import FeatureGrid from "@/modules/home/FeatureGrid.astro";
import ClosingCta from "@/modules/home/ClosingCta.astro";
import ProductHero from "@/modules/product/ProductHero.astro";
import ProductSplit from "@/modules/product/ProductSplit.astro";
import ProductFaqs from "@/modules/product/ProductFaqs.astro";
import AppScenes from "@/modules/product/scenes/AppScenes";
import FinanceScenes from "@/modules/product/scenes/FinanceScenes";
import ShopScenes from "@/modules/product/scenes/ShopScenes";
import { productSceneLabels } from "@/modules/product/scenes/labels";
import { intlLocaleForLang } from "@/lib/intl-locale";
import SoftwareApplicationSchema from "@/components/StructuredData/SoftwareApplication.astro";
import FAQPageSchema from "@/components/StructuredData/FAQPage.astro";
import { getCollection } from "astro:content";

export function getStaticPaths() {
    return localeStaticPaths();
}

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
const base = productSceneLabels(t);
const labels = base;
const shopLabels = { ...base, s: t.shopScenes };
const locale = intlLocaleForLang(lang);

const faqsCollection = await getCollection("faqs");
const familiesFaqs = faqsCollection.find((entry) => entry.id === "faqsFamilies.md");

const features = [
    {
        icon: "Smartphone",
        title: t.features.familiesFeatures.mobileApp.title,
        description: t.features.familiesFeatures.mobileApp.tagline,
        navigateTo: localePath(lang, "/app"),
    },
    {
        icon: "CreditCard",
        title: t.features.familiesFeatures.digitalBilling.title,
        description: t.features.familiesFeatures.digitalBilling.tagline,
        navigateTo: localePath(lang, "/internal-payments"),
    },
    {
        icon: "ShoppingCart",
        title: t.features.familiesFeatures.onlineStore.title,
        description: t.features.familiesFeatures.onlineStore.tagline,
        navigateTo: localePath(lang, "/shop"),
    },
    {
        icon: "Bell",
        title: t.features.familiesFeatures.realTimeNotifications.title,
        description: t.features.familiesFeatures.realTimeNotifications.tagline,
        navigateTo: localePath(lang, "/communication"),
    },
    {
        icon: "FileText",
        title: t.features.familiesFeatures.digitalDocuments.title,
        description: t.features.familiesFeatures.digitalDocuments.tagline,
        navigateTo: localePath(lang, "/app"),
    },
    {
        icon: "MessageSquare",
        title: t.features.familiesFeatures.secureCommunication.title,
        description: t.features.familiesFeatures.secureCommunication.tagline,
        navigateTo: localePath(lang, "/communication"),
    },
];
---

<Layout
    content={{
        title: t.meta.familiesTitle,
        description: t.meta.familiesDescription,
    }}
    lang={lang}
    design="premium"
>
    <HomeMotion />
    <ProductHero t={t} title={t.families.mainTitle} description={t.families.mainDescription} bleed>
        <AppScenes slot="visual" client:visible scene="trio" labels={labels} locale={locale} />
    </ProductHero>
    <ProductSplit
        t={t}
        left={{ title: t.families.mobileAppTitle, description: t.families.mobileAppDescription, cta: true, bleed: true }}
        right={{ title: t.families.digitalBillingTitle, description: t.families.digitalBillingDescription, bleed: true }}
    >
        <AppScenes slot="left" client:visible scene="stores" labels={labels} locale={locale} />
        <FinanceScenes slot="right" client:visible scene="pay" labels={labels} locale={locale} />
    </ProductSplit>
    <FeatureGrid t={t} features={features} title={t.features.familiesFeatures.title} description={t.features.familiesFeatures.tagline} />
    <ProductSplit
        t={t}
        title={t.families.communicationAndStoreTitle}
        description={t.families.communicationAndStoreDescription}
        left={{ title: t.families.appFeaturesTitle, description: t.families.appFeaturesDescription, bleed: true }}
        right={{ title: t.families.onlineStoreTitle, description: t.families.onlineStoreDescription, bleed: true }}
    >
        <AppScenes slot="left" client:visible scene="album" labels={labels} locale={locale} />
        <ShopScenes slot="right" client:visible scene="quick" labels={shopLabels} locale={locale} />
    </ProductSplit>
    <ProductFaqs
        t={t}
        title={t.faqs.families?.title ?? t.faqs.title}
        description={t.faqs.families?.description ?? t.faqs.description}
        faqs={familiesFaqs?.data.faqs ?? []}
    />
    <ClosingCta lang={lang} />
    <SoftwareApplicationSchema
        slot="structured-data"
        name="Edena - Portal para Familias"
        description={t.meta.familiesDescription}
        applicationCategory="EducationalApplication"
        operatingSystem={["Web", "iOS", "Android"]}
        url={`https://edena.es/${lang}/families`}
        lang={lang}
    />
    {
        familiesFaqs?.data.faqs && (
            <FAQPageSchema
                slot="structured-data"
                faqs={familiesFaqs.data.faqs}
                translations={t.faqs}
                lang={lang}
            />
        )
    }
</Layout>
