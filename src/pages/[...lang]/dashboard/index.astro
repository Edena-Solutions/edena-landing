---
import { translations, localeStaticPaths, localePath } from "@/i18n/index.ts";

import Layout from "@/layouts/main.astro";
import HomeMotion from "@/modules/home/HomeMotion.astro";
import FeatureGrid from "@/modules/home/FeatureGrid.astro";
import ClosingCta from "@/modules/home/ClosingCta.astro";
import ProductHero from "@/modules/product/ProductHero.astro";
import ProductSplit from "@/modules/product/ProductSplit.astro";
import ProductFaqs from "@/modules/product/ProductFaqs.astro";
import DashboardScenes from "@/modules/product/scenes/DashboardScenes";
import TrackingScenes from "@/modules/product/scenes/TrackingScenes";
import CommunicationScenes from "@/modules/product/scenes/CommunicationScenes";
import { productSceneLabels } from "@/modules/product/scenes/labels";
import { intlLocaleForLang } from "@/lib/intl-locale";
import SoftwareApplicationSchema from "@/components/StructuredData/SoftwareApplication.astro";
import FAQPageSchema from "@/components/StructuredData/FAQPage.astro";
import { getCollection } from "astro:content";

export function getStaticPaths() {
    return localeStaticPaths();
}

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
const base = productSceneLabels(t);
const labels = { ...base, db: t.dashboardScenes };
const trackingLabels = { ...base, tr: t.trackingScenes };
const communicationLabels = { ...base, c: t.communicationScenes };
const locale = intlLocaleForLang(lang);

const faqsCollection = await getCollection("faqs");
const dashboardFaqs = faqsCollection.find((entry) => entry.id === "faqsDashboard.md");

const features = [
    {
        icon: "BarChart3",
        title: t.features.dashboardFeatures.realTimeAnalytics.title,
        description: t.features.dashboardFeatures.realTimeAnalytics.tagline,
        navigateTo: localePath(lang, "/groups"),
    },
    {
        icon: "TrendingUp",
        title: t.features.dashboardFeatures.performanceInsights.title,
        description: t.features.dashboardFeatures.performanceInsights.tagline,
        navigateTo: localePath(lang, "/students"),
    },
    {
        icon: "Settings",
        title: t.features.dashboardFeatures.resourceOptimization.title,
        description: t.features.dashboardFeatures.resourceOptimization.tagline,
        navigateTo: localePath(lang, "/tracking"),
    },
    {
        icon: "MessageCircle",
        title: t.features.dashboardFeatures.communicationHub.title,
        description: t.features.dashboardFeatures.communicationHub.tagline,
        navigateTo: localePath(lang, "/communication"),
    },
    {
        icon: "Shield",
        title: t.features.dashboardFeatures.complianceTracking.title,
        description: t.features.dashboardFeatures.complianceTracking.tagline,
        navigateTo: localePath(lang, "/data-processing"),
    },
    {
        icon: "FileText",
        title: t.features.dashboardFeatures.customReports.title,
        description: t.features.dashboardFeatures.customReports.tagline,
        navigateTo: localePath(lang, "/finance"),
    },
];
---

<Layout
    content={{
        title: t.meta.dashboardTitle,
        description: t.meta.dashboardDescription,
    }}
    lang={lang}
    design="premium"
>
    <HomeMotion />
    <ProductHero t={t} title={t.dashboard.mainTitle} description={t.dashboard.mainDescription} bleed>
        <DashboardScenes slot="visual" client:visible scene="overview" labels={labels} locale={locale} />
    </ProductHero>
    <ProductSplit
        t={t}
        left={{ title: t.dashboard.notificationsTitle, description: t.dashboard.notificationsDescription, cta: true, bleed: true }}
        right={{ title: t.dashboard.quickActionsTitle, description: t.dashboard.quickActionsDescription, bleed: true }}
    >
        <DashboardScenes slot="left" client:visible scene="alerts" labels={labels} locale={locale} />
        <DashboardScenes slot="right" client:visible scene="quick" labels={labels} locale={locale} />
    </ProductSplit>
    <FeatureGrid t={t} features={features} title={t.features.dashboardFeatures.title} description={t.features.dashboardFeatures.tagline} actions />
    <ProductSplit
        t={t}
        title={t.dashboard.notificationsAndCalendarTitle}
        description={t.dashboard.notificationsAndCalendarDescription}
        left={{ title: t.dashboard.calendarTitle, description: t.dashboard.calendarDescription, bleed: true, cta: "demo" }}
        right={{ title: t.dashboard.realTimeNotificationsExtendedTitle, description: t.dashboard.realTimeNotificationsExtendedDescription, bleed: true, cta: "trial" }}
    >
        <TrackingScenes slot="left" client:visible scene="week" labels={trackingLabels} locale={locale} />
        <CommunicationScenes slot="right" client:visible scene="delivered" labels={communicationLabels} locale={locale} />
    </ProductSplit>
    <ProductFaqs
        t={t}
        title={t.faqs.dashboard?.title ?? t.faqs.title}
        description={t.faqs.dashboard?.description ?? t.faqs.description}
        faqs={dashboardFaqs?.data.faqs ?? []}
    />
    <ClosingCta lang={lang} />
    <SoftwareApplicationSchema
        slot="structured-data"
        name={t.schema.dashboard}
        description={t.meta.dashboardDescription}
        applicationCategory="EducationalApplication"
        operatingSystem={["Web", "iOS", "Android"]}
        url={`https://edena.es/${lang}/dashboard`}
        lang={lang}
    />
    {
        dashboardFaqs?.data.faqs && (
            <FAQPageSchema
                slot="structured-data"
                faqs={dashboardFaqs.data.faqs}
                translations={t.faqs}
                lang={lang}
            />
        )
    }
</Layout>
