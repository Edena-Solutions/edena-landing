---
import { Download, FileText } from "lucide-react";
import { translations, localeStaticPaths } from "@/i18n/index.ts";
import Layout from "@/layouts/main.astro";
import Button from "@/components/ds/Button.astro";
import LegalPage from "@/modules/legal/LegalPage.astro";
import { linkify } from "@/lib/legal-content";
import { formatLongDate } from "@/lib/intl-locale";
import {
    currentVerifactuDeclaration as current,
    verifactuDeclarations,
    type VerifactuDeclarationItem,
} from "@/data/verifactuDeclarations";

/*
 * The producer's declaration for the invoicing system (VERI*FACTU), in the legal pages' design: what
 * it is, the version in force with its signed PDF, the declaration itself as a fact sheet per
 * section, and every earlier version. The declaration is signed in Spanish and reproduced as-is on
 * every locale.
 */

export function getStaticPaths() {
    return localeStaticPaths();
}

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
const d = t.verifactuDeclarationPage;

const formatDate = (iso: string) => formatLongDate(lang, iso);
const signed = d.signed.replace("{place}", current.signedAt).replace("{date}", formatDate(current.signedOn));

const sections: Array<{ id: string; number: string; title: string; items: VerifactuDeclarationItem[] }> = [
    { id: "section-1", number: "1", title: "Declaración responsable", items: current.items },
    { id: "section-2", number: "2", title: "Anexo: información adicional", items: current.annex },
];
const toc = [
    ...sections.map(({ id, number, title }) => ({ id, number, title })),
    { id: "history", number: "3", title: d.historyTitle },
];
---

<Layout content={{ title: t.meta.verifactuTitle, description: t.meta.verifactuDescription }} lang={lang} design="premium">
    <LegalPage t={t} lang={lang} title={d.title} updated={signed} toc={toc} current="verifactu">
        <article class="legal-prose">
            <div class="legal-intro">
                <p>{d.intro}</p>
                <p>{d.aeatNote}</p>
                {d.languageNote && <p>{d.languageNote}</p>}
            </div>

            <!-- The version in force, and its signed copy. -->
            <div class="mt-10 flex flex-col gap-5 rounded-[1.5rem] bg-canvas-2 p-6 sm:flex-row sm:items-center sm:p-7">
                <span class="ds-app-icon size-12 bg-sys-green">
                    <FileText className="size-6" />
                </span>
                <span class="flex min-w-0 flex-1 flex-col gap-1">
                    <span class="type-callout font-semibold text-ink">
                        {d.currentVersion}: Edena {current.version}
                    </span>
                    <span class="type-footnote text-ink-2">{signed}</span>
                </span>
                <Button href={current.pdfPath} download class="shrink-0">
                    <Download />
                    {d.downloadPdf}
                </Button>
            </div>

            {
                sections.map((section, index) => (
                    <section id={section.id} lang="es" class:list={["legal-section", index === 0 && "mt-14"]}>
                        <h2>
                            <span class="legal-number">{section.number}</span>
                            <span>{section.title}</span>
                        </h2>
                        <dl>
                            {section.items.map((item) => (
                                <div>
                                    <dt>
                                        <span class="tabular-nums text-ink-3">{item.id}</span> {item.label}
                                    </dt>
                                    <dd>
                                        {item.value.map((paragraph) => (
                                            <p>{linkify(paragraph).map((part) => (part.href ? <a href={part.href}>{part.text}</a> : part.text))}</p>
                                        ))}
                                    </dd>
                                </div>
                            ))}
                        </dl>
                    </section>
                ))
            }

            <!-- Every version, with its signed copy. -->
            <section id="history" class="legal-section">
                <h2>
                    <span class="legal-number">3</span>
                    <span>{d.historyTitle}</span>
                </h2>
                <div class="overflow-hidden rounded-[1.25rem] bg-canvas-2">
                    <table class="w-full border-collapse text-left text-[0.9375rem] sm:text-base">
                        <thead>
                            <tr class="type-footnote text-ink-2">
                                <th class="px-3.5 py-3.5 sm:px-5 font-medium">{d.historyVersion}</th>
                                <th class="px-3.5 py-3.5 sm:px-5 font-medium">{d.historyDate}</th>
                                <th class="px-3.5 py-3.5 sm:px-5 text-right font-medium">{d.historyDocument}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {
                                verifactuDeclarations.map((declaration) => (
                                    <tr class="border-t border-hairline">
                                        <td class="px-3.5 py-4 sm:px-5 font-semibold tabular-nums">{declaration.version}</td>
                                        <td class="px-3.5 py-4 sm:px-5">{formatDate(declaration.signedOn)}</td>
                                        <td class="px-3.5 py-4 sm:px-5 text-right">
                                            <a href={declaration.pdfPath} download class="inline-flex items-center gap-1.5">
                                                <Download className="size-4" />
                                                PDF
                                            </a>
                                        </td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </article>
    </LegalPage>
</Layout>

<style>
    /* The declaration's entries read as label over text: they run long. */
    .legal-prose dl > div {
        grid-template-columns: minmax(0, 1fr) !important;
        gap: 0.35rem;
    }

    .legal-prose dt {
        font-weight: 600;
        color: var(--ds-ink);
    }

    .legal-prose dd {
        font-weight: 400;
        color: var(--ds-ink-2);
    }
</style>
