---
import { translations, localeStaticPaths } from "@/i18n/index.ts";
import Layout from "@/layouts/main.astro";
import Button from "@/components/ds/Button.astro";
import LegalDocument from "@/modules/legal/LegalDocument.astro";

export function getStaticPaths() {
    return localeStaticPaths();
}

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
---

<Layout content={{ title: t.meta.deleteAccountTitle, description: t.meta.deleteAccountDescription }} lang={lang} design="premium">
    <LegalDocument t={t} lang={lang} title={t.deleteAccount.title} content={t.deleteAccount.content} current="delete">
        <Button slot="actions" href="mailto:dpo@edena.es?subject=Solicitud%20de%20eliminaci%C3%B3n%20de%20cuenta" size="lg" class="mt-3">
            {t.deleteAccount.cta}
        </Button>
    </LegalDocument>
</Layout>
