---
import { translations, localeStaticPaths, localePath } from "@/i18n/index.ts";
import Layout from "@/layouts/main.astro";
import HomeMotion from "@/modules/home/HomeMotion.astro";
import FeatureGrid from "@/modules/home/FeatureGrid.astro";
import ClosingCta from "@/modules/home/ClosingCta.astro";
import ProductHero from "@/modules/product/ProductHero.astro";
import ProductSplit from "@/modules/product/ProductSplit.astro";
import ProductFaqs from "@/modules/product/ProductFaqs.astro";
import AssignmentScenes from "@/modules/product/scenes/AssignmentScenes";
import { productSceneLabels } from "@/modules/product/scenes/labels";
import { intlLocaleForLang } from "@/lib/intl-locale";
import SoftwareApplicationSchema from "@/components/StructuredData/SoftwareApplication.astro";
import FAQPageSchema from "@/components/StructuredData/FAQPage.astro";
import { getCollection } from "astro:content";

export function getStaticPaths() {
    return localeStaticPaths();
}

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
const base = productSceneLabels(t);
const labels = { ...base, as: t.assignmentScenes };
const locale = intlLocaleForLang(lang);

const faqsCollection = await getCollection("faqs");
const assignmentFaqs = faqsCollection.find((entry) => entry.id === "faqsAssignment.md");

const features = [
    {
        icon: "Calendar",
        title: t.features.assignmentFeatures.scheduleManagement.title,
        description: t.features.assignmentFeatures.scheduleManagement.tagline,
        navigateTo: localePath(lang, "/students"),
    },
    {
        icon: "RotateCcw",
        title: t.features.assignmentFeatures.evaluationCycles.title,
        description: t.features.assignmentFeatures.evaluationCycles.tagline,
        navigateTo: localePath(lang, "/dashboard"),
    },
    {
        icon: "BarChart3",
        title: t.features.assignmentFeatures.gradeManagement.title,
        description: t.features.assignmentFeatures.gradeManagement.tagline,
        navigateTo: localePath(lang, "/students"),
    },
    {
        icon: "FileCheck",
        title: t.features.assignmentFeatures.automatedReports.title,
        description: t.features.assignmentFeatures.automatedReports.tagline,
        navigateTo: localePath(lang, "/families"),
    },
    {
        icon: "Users",
        title: t.features.assignmentFeatures.familyVisibility.title,
        description: t.features.assignmentFeatures.familyVisibility.tagline,
        navigateTo: localePath(lang, "/app"),
    },
    {
        icon: "Link",
        title: t.features.assignmentFeatures.integration.title,
        description: t.features.assignmentFeatures.integration.tagline,
        navigateTo: localePath(lang, "/communication"),
    },
];
---

<Layout
    content={{
        title: t.meta.assignmentTitle,
        description: t.meta.assignmentDescription,
    }}
    lang={lang}
    design="premium"
>
    <HomeMotion />
    <ProductHero t={t} title={t.assignment.mainTitle} description={t.assignment.mainDescription} bleed>
        <AssignmentScenes slot="visual" client:visible scene="gradebook" labels={labels} locale={locale} />
    </ProductHero>
    <ProductSplit
        t={t}
        left={{ title: t.assignment.scheduleTitle, description: t.assignment.scheduleDescription, cta: true, bleed: true }}
        right={{ title: t.assignment.evaluationTitle, description: t.assignment.evaluationDescription, bleed: true }}
    >
        <AssignmentScenes slot="left" client:visible scene="planner" labels={labels} locale={locale} />
        <AssignmentScenes slot="right" client:visible scene="grades" labels={labels} locale={locale} />
    </ProductSplit>
    <FeatureGrid t={t} features={features} title={t.features.assignmentFeatures.title} description={t.features.assignmentFeatures.tagline} actions />
    <ProductSplit
        t={t}
        title={t.assignment.cyclesAndScoresTitle}
        description={t.assignment.cyclesAndScoresDescription}
        left={{ title: t.assignment.cyclesTitle, description: t.assignment.cyclesDescription, bleed: true, cta: "demo" }}
        right={{ title: t.assignment.scoresTitle, description: t.assignment.scoresDescription, bleed: true, cta: "trial" }}
    >
        <AssignmentScenes slot="left" client:visible scene="cycles" labels={labels} locale={locale} />
        <AssignmentScenes slot="right" client:visible scene="progress" labels={labels} locale={locale} />
    </ProductSplit>
    <ProductFaqs
        t={t}
        title={t.faqs.assignment?.title ?? t.faqs.title}
        description={t.faqs.assignment?.description ?? t.faqs.description}
        faqs={assignmentFaqs?.data.faqs ?? []}
    />
    <ClosingCta lang={lang} />
    <SoftwareApplicationSchema
        slot="structured-data"
        name={t.schema.assignment}
        description={t.meta.assignmentDescription}
        applicationCategory="EducationalApplication"
        operatingSystem={["Web", "iOS", "Android"]}
        url={`https://edena.es/${lang}/assignment`}
        lang={lang}
    />
    {
        assignmentFaqs?.data.faqs && (
            <FAQPageSchema
                slot="structured-data"
                faqs={assignmentFaqs.data.faqs}
                translations={t.faqs}
                lang={lang}
            />
        )
    }
</Layout>
