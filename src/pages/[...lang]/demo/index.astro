---
import { translations, localeStaticPaths, localePath } from "@/i18n/index.ts";

import Layout from "@/layouts/main.astro";
import FAQPageSchema from "@/components/StructuredData/FAQPage.astro";
import Button from "@/components/ds/Button.astro";
import HomeMotion from "@/modules/home/HomeMotion.astro";
import PageHero from "@/modules/product/PageHero.astro";
import ProductFaqs from "@/modules/product/ProductFaqs.astro";

/*
 * Booking a demo, in the home's design: the promise, the calendar in a tile, the questions people
 * ask before booking, and the way to the prices.
 */

export function getStaticPaths() {
    return localeStaticPaths();
}

const { lang } = Astro.props;
const t = translations[lang as keyof typeof translations];
const d = t.demoPage;

const calendlyUrl = "https://calendly.com/edena-software/1h-meeting";
const pricingUrl = localePath(lang, "/pricing");
---

<Layout content={{ title: t.meta.demoTitle, description: t.meta.demoDescription }} lang={lang} design="premium">
    <HomeMotion />
    <PageHero title={d.heroTitle} description={d.heroDescription}>
        <p class="ds-intro mt-5 type-footnote text-ink-3" style="--intro-i: 2">
            {t.hero.verifactuReady} · {t.noCreditCardRequired}
        </p>
    </PageHero>
    <section class="ds-section pt-12 sm:pt-16">
        <div class="ds-container" data-reveal="rise">
            <!-- The booking calendar, on white in both themes: it is Calendly's own page. -->
            <div class="overflow-hidden rounded-tile bg-white ring-1 ring-hairline elev-2">
                <div
                    id="calendly-inline-demo"
                    class="calendly-inline-widget"
                    data-url={calendlyUrl}
                    style="min-width:320px;height:700px;"
                >
                </div>
            </div>
        </div>
    </section>
    <ProductFaqs t={t} title={d.faqTitle} description="" faqs={d.faqs} />
    <div class="ds-container flex justify-center pb-24">
        <Button href={pricingUrl} variant="secondary" size="lg">{d.pricingLinkLabel}</Button>
    </div>
    <FAQPageSchema slot="structured-data" faqs={d.faqs} translations={{}} lang={lang} />
    <script is:inline>
        document.addEventListener("astro:page-load", () => {
            const parent = document.getElementById("calendly-inline-demo");
            if (!parent) return;
            const url = parent.getAttribute("data-url");
            if (!url) return;
            parent.replaceChildren();

            const inject = () => {
                if (!window.Calendly) return;
                const el = document.getElementById("calendly-inline-demo");
                if (!el) return;
                const u = el.getAttribute("data-url");
                if (!u) return;
                el.replaceChildren();
                window.Calendly.initInlineWidget({ url: u, parentElement: el });
            };

            if (window.Calendly) {
                inject();
                return;
            }

            let script = document.querySelector("script[data-calendly-widget-js]");
            if (!script) {
                script = document.createElement("script");
                script.src = "https://assets.calendly.com/assets/external/widget.js";
                script.async = true;
                script.dataset.calendlyWidgetJs = "1";
                script.onload = inject;
                document.head.appendChild(script);
                return;
            }

            if (window.Calendly) inject();
            else script.addEventListener("load", inject, { once: true });
        });
    </script>
</Layout>
