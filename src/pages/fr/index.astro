---
import { translations } from "@/i18n/index.ts";
import Layout from "@/layouts/main.astro";
import HomeMotion from "@/modules/home/HomeMotion.astro";
import Hero from "@/modules/home/Hero.astro";
import ProblemSection from "@/modules/home/ProblemSection.astro";
import WallOfFeatures from "@/modules/home/WallOfFeatures.astro";
import EnaShowcase from "@/modules/home/EnaShowcase.astro";
import MarketStats from "@/modules/home/MarketStats.astro";
import KeyFeatures from "@/modules/home/KeyFeatures.astro";
import FeatureGrid from "@/modules/home/FeatureGrid.astro";
import ClosingCta from "@/modules/home/ClosingCta.astro";
import SoftwareApplicationSchema from "@/components/StructuredData/SoftwareApplication.astro";

const lang = "fr";
const t = translations[lang];

const features = [
    {
        icon: "FileText",
        title: t.features.digitalRecords.title,
        description: t.features.digitalRecords.tagline,
        cta: t.features.digitalRecords.cta,
        navigateTo: "/fr/students/",
    },
    {
        icon: "Smartphone",
        title: t.features.mobileApp.title,
        description: t.features.mobileApp.tagline,
        cta: t.features.mobileApp.cta,
        navigateTo: "/fr/app/",
    },
    {
        icon: "FolderOpen",
        title: t.features.documentManagement.title,
        description: t.features.documentManagement.tagline,
        cta: t.features.documentManagement.cta,
        navigateTo: "/fr/dashboard/",
    },
    {
        icon: "Users",
        title: t.features.familyPortal.title,
        description: t.features.familyPortal.tagline,
        cta: t.features.familyPortal.cta,
        navigateTo: "/fr/families/",
    },
    {
        icon: "UserSquare",
        title: t.features.staffManagement.title,
        description: t.features.staffManagement.tagline,
        cta: t.features.staffManagement.cta,
        navigateTo: "/fr/groups/",
    },
    {
        icon: "Calendar",
        title: t.features.calendarIntegration.title,
        description: t.features.calendarIntegration.tagline,
        cta: t.features.calendarIntegration.cta,
        navigateTo: "/fr/assignment/",
    },
];
---

<Layout content={{ title: t.meta.homeTitle, description: t.meta.homeDescription }} lang={lang} design="premium">
    <SoftwareApplicationSchema
        slot="structured-data"
        name="Edena"
        description={t.meta.homeDescription}
        applicationCategory="EducationalApplication"
        operatingSystem={["Web", "iOS", "Android"]}
        url="https://edena.es/fr/"
        lang={lang}
    />
    <HomeMotion />
    <Hero t={t} />
    <ProblemSection t={t} />
    <WallOfFeatures t={t} lang={lang} />
    <EnaShowcase t={t} />
    <MarketStats t={t} />
    <KeyFeatures t={t} lang={lang} />
    <FeatureGrid t={t} features={features} />
    <ClosingCta lang={lang} />
</Layout>
